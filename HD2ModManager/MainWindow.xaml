<Window x:Class="HD2ModManager.MainWindow"
    x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:HD2ModManager.Views"
        xmlns:localVM="clr-namespace:HD2ModManager.ViewModels"
        xmlns:localViews="clr-namespace:HD2ModManager.Views"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{StaticResource AppSurfaceBrush}"
        Title="HD2 Mod Manager" Height="720" Width="1200" MinHeight="720" MinWidth="1200">
    <Window.Resources>
        <localVM:NotificationBrushConverter x:Key="NotificationBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <localViews:BoolToStarLengthConverter x:Key="BoolToStarLength"/>

        <Style x:Key="WorkspacePageHost" TargetType="ContentControl">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        </Style>

        <DataTemplate DataType="{x:Type localVM:HomePageViewModel}">
            <views:HomePageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type localVM:ProfilePageViewModel}">
            <views:ProfilePageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type localVM:LibraryPageViewModel}">
            <views:LibraryPageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type localVM:SettingsPageViewModel}">
            <views:SettingsPageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type localVM:ModDetailsPageViewModel}">
            <views:ModDetailsPageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type localVM:AdvancedModDetailsPageViewModel}">
            <views:AdvancedModDetailsPageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type localVM:GameDataBrowserPageViewModel}">
            <views:GameDataBrowserPageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type localVM:GameDataArchiveDetailsHostPageViewModel}">
            <views:GameDataArchiveDetailsPageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type views:CrossArmorTransferPlanWindowViewModel}">
            <views:CrossArmorPlanPageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type localVM:MaterialPackagingPageViewModel}">
            <views:MaterialPackagingPageView/>
        </DataTemplate>
        <Style x:Key="TopNavButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Panel.ZIndex" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CapsulePartButton" TargetType="Button" BasedOn="{StaticResource TopNavButton}">
        </Style>

        <Style x:Key="CapsuleRoundButton" TargetType="Button" BasedOn="{StaticResource CapsulePartButton}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="CaptionButtonGreyHover" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D9D9D9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#BFBFBF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionButtonRedHover" TargetType="Button" BasedOn="{StaticResource CaptionButtonGreyHover}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E53935"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B71C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource SurfaceCard}" shell:WindowChrome.IsHitTestVisibleInChrome="True" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Margin="16,0,18,0" VerticalAlignment="Center">
                <TextBlock Text="HD2 Mod Manager" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers><DataTrigger Binding="{Binding ShowHomeTitle}" Value="False"><Setter Property="Visibility" Value="Hidden"/></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Content="启动游戏" Command="{Binding LaunchGameCommand}" Padding="14,5">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource AppPrimaryButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding ShowLaunchGameButton}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <Grid x:Name="WorkspaceNavigationHost" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="WorkspaceNavigationIndicator" Height="32" Background="{StaticResource Accent}" CornerRadius="16"/>
                </Canvas>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button x:Name="HomeNavigationButton" Command="{Binding ShowHomeCommand}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="15" Height="15" Margin="0,0,6,0" Data="M2,7 L8,2 L14,7 L14,14 L10,14 L10,10 L6,10 L6,14 L2,14 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round"/>
                        <TextBlock Text="首页" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TopNavButton}">
                            <Style.Triggers><DataTrigger Binding="{Binding IsHomeActive}" Value="True"><Setter Property="Tag" Value="Active"/></DataTrigger></Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <localViews:CapsuleButtonGroup x:Name="WorkspaceCapsuleGroup" Width="168" Height="40" Margin="10,0"
                                               MiddleContent="配置页  |  模组库"
                                               LeftToolTip="只打开配置页" MiddleToolTip="合并为左右双页" RightToolTip="只打开模组库"
                                               LeftCommand="{Binding ShowProfileCommand}"
                                               MiddleCommand="{Binding ShowSplitCommand}"
                                               RightCommand="{Binding ShowLibraryCommand}"
                                               LeftIsActive="{Binding IsProfileActive}"
                                               MiddleIsActive="{Binding IsSplitActive}"
                                               RightIsActive="{Binding IsLibraryActive}"/>
                <Button x:Name="SettingsNavigationButton" Command="{Binding ShowSettingsCommand}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="15" Height="15" Margin="0,0,6,0" Data="M8,4.5 A3.5,3.5 0 1 0 8,11.5 A3.5,3.5 0 1 0 8,4.5 M8,1.5 L8,3 M8,13 L8,14.5 M1.5,8 L3,8 M13,8 L14.5,8 M3.4,3.4 L4.5,4.5 M11.5,11.5 L12.6,12.6 M12.6,3.4 L11.5,4.5 M4.5,11.5 L3.4,12.6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" StrokeStartLineCap="Round"/>
                        <TextBlock Text="设置" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TopNavButton}">
                            <Style.Triggers><DataTrigger Binding="{Binding IsSettingsActive}" Value="True"><Setter Property="Tag" Value="Active"/></DataTrigger></Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="MessageNavigationButton" Style="{StaticResource TopNavButton}" Command="{Binding ToggleMessagePanelCommand}" Margin="0,8,6,8" Padding="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="15" Height="15" Margin="0,0,6,0" Data="M3,4 L13,4 L13,14 L3,14 Z M5,7 L11,7 M5,10 L9,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        <TextBlock Text="消息" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.ToolTip>
                        <TextBlock Text="查看任务状态与最近消息"/>
                    </Button.ToolTip>
                </Button>
                <Button Style="{StaticResource CaptionButtonGreyHover}" Click="MinButton_Click"><Path Width="12" Height="12" StrokeThickness="1.5" Stroke="Black" Data="M 1,5 L 11,5"/></Button>
                <Button Style="{StaticResource CaptionButtonGreyHover}" Click="MaxButton_Click"><Path Width="12" Height="12" StrokeThickness="1.3" Stroke="Black" Data="M 1,1 L 11,1 11,11 1,11 Z"/></Button>
                <Button Style="{StaticResource CaptionButtonRedHover}" Click="CloseButton_Click"><Path Width="12" Height="12" StrokeThickness="1.6" Stroke="Black" Data="M 2,2 L 10,10 M 10,2 L 2,10"/></Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid Margin="{StaticResource LayoutGapThickness}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{Binding ShowRightSlot, Converter={StaticResource BoolToStarLength}, ConverterParameter=12}"/>
                    <ColumnDefinition Width="{Binding ShowRightSlot, Converter={StaticResource BoolToStarLength}}"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="Transparent" BorderThickness="0" ClipToBounds="True">
                    <Grid>
                        <ContentControl x:Name="LeftPreviousPageHost" Style="{StaticResource WorkspacePageHost}" IsHitTestVisible="False"/>
                        <ContentControl x:Name="LeftCurrentPageHost" Style="{StaticResource WorkspacePageHost}"/>
                        <views:FloatingActionCluster HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18" LabelDirection="Right" Actions="{Binding LeftSlotActions}" Visibility="{Binding ShowSplitLeftSlotActions, Converter={StaticResource BoolToVis}}"/>
                        <views:FloatingActionCluster HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="18" Actions="{Binding LeftSlotActions}" Visibility="{Binding ShowFullScreenActions, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Visibility="{Binding ShowRightSlot, Converter={StaticResource BoolToVis}}"/>

                <Border Grid.Column="2" Background="Transparent" BorderThickness="0" ClipToBounds="True" Visibility="{Binding ShowRightSlot, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <ContentControl x:Name="RightPreviousPageHost" Style="{StaticResource WorkspacePageHost}" IsHitTestVisible="False"/>
                        <ContentControl x:Name="RightCurrentPageHost" Style="{StaticResource WorkspacePageHost}"/>
                        <views:FloatingActionCluster HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="18" Actions="{Binding RightSlotActions}" Visibility="{Binding ShowRightSlotActions, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>

                <Canvas x:Name="PageTransitionOverlay" Grid.ColumnSpan="3" IsHitTestVisible="False" ClipToBounds="False">
                    <ContentControl x:Name="OverlayLeftPageHost" Style="{StaticResource WorkspacePageHost}"/>
                    <ContentControl x:Name="OverlayRightPageHost" Style="{StaticResource WorkspacePageHost}"/>
                </Canvas>
            </Grid>

            <Border x:Name="BottomContextBar" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22"
                    Padding="14,10" CornerRadius="18" RenderTransformOrigin="0.5,0.5"
                    Visibility="Collapsed">
                <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AppElevatedPanel}">
                    </Style>
                </Border.Style>
                <Grid x:Name="BottomContextBarContent" VerticalAlignment="Center">
                    <views:TemporaryEditorBarContent x:Name="BottomContextBarContentA" Opacity="1" IsHitTestVisible="True"/>
                    <views:TemporaryEditorBarContent x:Name="BottomContextBarContentB" Opacity="0" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <Border x:Name="MessageCenterPanel" Style="{StaticResource AppElevatedPanel}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="420" MaxHeight="560" Margin="0,0,4,0"
                    Padding="3" Panel.ZIndex="20" RenderTransformOrigin="0.5,0"
                    Visibility="Collapsed">
                <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
                <Grid>
					<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
					<DockPanel Margin="4,2,2,2">
						<TextBlock Text="消息" FontWeight="SemiBold" VerticalAlignment="Center"/>
						<Button DockPanel.Dock="Right" Style="{StaticResource AppQuietButton}" Content="复制所选" Padding="7,3" Click="OnCopySelectedMessagesClick"/>
					</DockPanel>
                    <ListBox Grid.Row="1" x:Name="MessageList" ItemsSource="{Binding MessageItems}" Style="{StaticResource ModListBox}" BorderThickness="0" SelectionMode="Extended" Loaded="OnMessageListLoaded" Padding="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ModListRowContainer}" Height="Auto" Padding="5,4" Margin="0,1">
									<Border.ContextMenu>
										<ContextMenu>
											<MenuItem Header="复制消息" Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
										</ContextMenu>
									</Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" Data="M8,2 A6,6 0 1 0 8,14 A6,6 0 1 0 8,2 M8,5 L8,9 M8,11 L8,11.2" Stroke="{StaticResource Accent}" StrokeThickness="1.4" StrokeStartLineCap="Round"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
											<Button Style="{StaticResource AppQuietButton}" Content="复制" Padding="6,2" Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource AppQuietButton}" Content="取消" Command="{Binding DataContext.CancelTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Task}" Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"/>
                                            <Button Style="{StaticResource AppQuietButton}" Content="重试" Command="{Binding DataContext.RetryTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Task}" Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

                <Border x:Name="MessagePreviewPanel" Style="{StaticResource AppElevatedPanel}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="420" Height="42" Margin="0,0,4,0"
                    Padding="3" Panel.ZIndex="19" ClipToBounds="True" Cursor="Hand"
                    Visibility="Collapsed" RenderTransformOrigin="0.5,0"
                    MouseLeftButtonDown="OnMessagePreviewClick">
                <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
                <ContentControl Content="{Binding LatestMessageItem}" IsHitTestVisible="False">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <Grid Margin="2,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center" Data="M7,1.5 A5.5,5.5 0 1 0 7,12.5 A5.5,5.5 0 1 0 7,1.5 M7,4 L7,7.5 M7,9.5 L7,9.7" Stroke="{StaticResource Accent}" StrokeThickness="1.3" StrokeStartLineCap="Round"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Border>
        </Grid>
    </Grid>
</Window>
