<Window x:Class="HD2ModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:HD2ModManager.Views"
        xmlns:localVM="clr-namespace:HD2ModManager.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="White"
        Title="HD2 Mod Manager" Height="720" Width="1200">
    <Window.Resources>
        <!-- Brushes -->
        <SolidColorBrush x:Key="TitleBarBrush" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="ContentBrush" Color="#FFFFFF"/>
        <localVM:NotificationBrushConverter x:Key="NotificationBrushConverter"/>
        
        <!-- Page templates mapping -->
        <DataTemplate DataType="{x:Type localVM:HomePageViewModel}">
            <views:HomePageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type localVM:SettingsPageViewModel}">
            <views:SettingsPageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type localVM:TagEditPageViewModel}">
            <views:TagEditPageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type localVM:LibraryPageViewModel}">
            <views:LibraryPageView/>
        </DataTemplate>
        <!-- Fallback for any PageViewModel -->
        <DataTemplate DataType="{x:Type localVM:PageViewModel}">
            <StackPanel>
                <TextBlock Text="[Fallback Page]" Foreground="#888" Margin="8"/>
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Margin="8,0,8,8"/>
                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
        <!-- Card templates mapping -->
        <DataTemplate DataType="{x:Type localVM:NavCardViewModel}">
            <views:NavCard/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type localVM:SettingToggleCardViewModel}">
            <views:SettingToggleCard/>
        </DataTemplate>
        <!-- Fallback for any CardViewModel -->
        <DataTemplate DataType="{x:Type localVM:CardViewModel}">
            <Border Margin="8" Padding="8" Background="#FAFAFA" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Width="220">
                <StackPanel>
                    <TextBlock Text="[Fallback Card]" Foreground="#888"/>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Description}" Foreground="#666"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Caption buttons: grey hover base style -->
        <Style x:Key="CaptionButtonGreyHover" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D9D9D9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#BFBFBF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close button: red hover style -->
        <Style x:Key="CaptionButtonRedHover" TargetType="Button" BasedOn="{StaticResource CaptionButtonGreyHover}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E53935"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B71C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Breadcrumb button style: no blue hover box, only change Foreground on hover/press -->
        <Style x:Key="BreadcrumbButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#1976D2"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Foreground" Value="#0D47A1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#999"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>


    <Border Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏：面包屑 + 窗口控制 -->
            <Grid Grid.Row="0"
                  Background="#FFFFFF"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 面包屑路径 -->
                <ItemsControl Grid.Column="0" ItemsSource="{Binding Breadcrumbs}" Margin="8,8" AlternationCount="1000">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text=">" Foreground="#888" Margin="6,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Content="{Binding}" Command="{Binding DataContext.GoBackToIndexCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Style="{StaticResource BreadcrumbButton}">
                                    <Button.CommandParameter>
                                        <Binding RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=ContentPresenter}" Path="(ItemsControl.AlternationIndex)"/>
                                    </Button.CommandParameter>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 窗口控制按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource CaptionButtonGreyHover}" Click="MinButton_Click">
                        <Path Width="12" Height="12" StrokeThickness="1.5" Stroke="Black" Data="M 1,5 L 11,5"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButtonGreyHover}" Click="MaxButton_Click">
                        <Path Width="12" Height="12" StrokeThickness="1.3" Stroke="Black" Data="M 1,1 L 11,1 11,11 1,11 Z"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButtonRedHover}" Click="CloseButton_Click">
                        <Path Width="12" Height="12" StrokeThickness="1.6" Stroke="Black" Data="M 2,2 L 10,10 M 10,2 L 2,10"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 内容区：渲染当前页面 -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Background="White"/>
            <!-- 底部通知栏 -->
            <Grid Grid.Row="2" HorizontalAlignment="Center" Margin="0,8,0,8">
                <ItemsControl ItemsSource="{Binding Notifications}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" Margin="0,4" CornerRadius="6" Background="{Binding Level, Converter={StaticResource NotificationBrushConverter}}" Opacity="0.95">
                                <TextBlock Text="{Binding Message}" Foreground="White"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Border>

</Window>
