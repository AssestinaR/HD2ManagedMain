<Window x:Class="HD2ModManager.Views.MaterialCandidateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择适配材质包" Width="720" Height="520" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#F5F6F8">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="候选会按精确 Material AssetKey 匹配；缺失资源只会提示，确认后仍按原始引用写出。" Foreground="#666" Margin="0,0,0,12"/>
        <ListBox x:Name="CandidateList" Grid.Row="1" ItemsSource="{Binding}" SelectedValuePath="NodeId">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="8" MinHeight="58">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Margin="0,5,0,0" Foreground="#666">
                                <Run Text="匹配材质 "/><Run Text="{Binding MatchingMaterialCount, Mode=OneWay}"/>
                                <Run Text="　缺失材质 "/><Run Text="{Binding MissingMaterialCount, Mode=OneWay}"/>
                                <Run Text="　缺失贴图 "/><Run Text="{Binding MissingTextureCount, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding BlockerSummary, Mode=OneWay}" Foreground="#B06A00" TextWrapping="Wrap" Margin="0,4,12,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText, Mode=OneWay}" Foreground="{Binding StatusBrush, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Width="88" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="选择" Width="88" IsDefault="True" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
