<UserControl x:Class="HD2ModManager.Views.CapsuleButtonGroup"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="40"
             MinHeight="28">
    <UserControl.Resources>
        <Style x:Key="CapsuleButtonBase" TargetType="Button">
            <Setter Property="Height" Value="{Binding ButtonHeight, ElementName=Root}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Panel.ZIndex" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{Binding ButtonCornerRadius, ElementName=Root}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{StaticResource AccentHover}"/>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CapsuleMiddleButton" TargetType="Button" BasedOn="{StaticResource CapsuleButtonBase}">
            <Setter Property="Padding" Value="44,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding MiddleIsActive, ElementName=Root}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CapsuleSideButton" TargetType="Button" BasedOn="{StaticResource CapsuleButtonBase}">
            <Setter Property="Width" Value="{Binding SideButtonSize, ElementName=Root}"/>
            <Setter Property="MinWidth" Value="{Binding SideButtonSize, ElementName=Root}"/>
            <Setter Property="Height" Value="{Binding SideButtonSize, ElementName=Root}"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger>
                <DataTrigger Binding="{Binding MiddleIsActive, ElementName=Root}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="Transparent"
            BorderBrush="{Binding CapsuleBorderBrush, ElementName=Root}"
            BorderThickness="{Binding CapsuleBorderThickness, ElementName=Root}"
            CornerRadius="{Binding CapsuleCornerRadius, ElementName=Root}"
            ClipToBounds="True"
            Padding="{Binding CapsulePadding, ElementName=Root}">
        <Grid VerticalAlignment="Center">
            <Button x:Name="MiddleButton"
                    HorizontalAlignment="Stretch"
                    MinWidth="{Binding MiddleMinWidth, ElementName=Root}"
                    Content="{Binding MiddleContent, ElementName=Root}"
                    Command="{Binding MiddleCommand, ElementName=Root}"
                    CommandParameter="{Binding MiddleCommandParameter, ElementName=Root}"
                    ToolTip="{Binding MiddleToolTip, ElementName=Root}"
                    Tag="{Binding MiddleIsActive, ElementName=Root}"
                    Style="{StaticResource CapsuleMiddleButton}"/>

            <Button x:Name="LeftButton"
                    HorizontalAlignment="Left"
                    Command="{Binding LeftCommand, ElementName=Root}"
                    CommandParameter="{Binding LeftCommandParameter, ElementName=Root}"
                    ToolTip="{Binding LeftToolTip, ElementName=Root}"
                    Tag="{Binding LeftIsActive, ElementName=Root}"
                    Style="{StaticResource CapsuleSideButton}">
                <Path Width="16" Height="16"
                      Data="M3,2.5 L12,2.5 L14,5 L14,13.5 L2,13.5 L2,5 Z M5,7 L11,7 M5,10 L9,10"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Button>

            <Button x:Name="RightButton"
                    HorizontalAlignment="Right"
                    Command="{Binding RightCommand, ElementName=Root}"
                    CommandParameter="{Binding RightCommandParameter, ElementName=Root}"
                    ToolTip="{Binding RightToolTip, ElementName=Root}"
                    Tag="{Binding RightIsActive, ElementName=Root}"
                    Style="{StaticResource CapsuleSideButton}">
                <Path Width="16" Height="16"
                      Data="M2,4 L14,4 L14,13 L2,13 Z M2,7 L14,7 M6,4 L6,13"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.35" StrokeLineJoin="Round"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
