<UserControl x:Class="HD2ModManager.Views.FloatingActionCluster"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HD2ModManager.Views"
             xmlns:vm="clr-namespace:HD2ModManager.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ClusterRoundButton" TargetType="Button">
            <Setter Property="Width" Value="{Binding ButtonDiameter, ElementName=Root}"/>
            <Setter Property="Height" Value="{Binding ButtonDiameter, ElementName=Root}"/>
            <Setter Property="MinWidth" Value="{Binding ButtonDiameter, ElementName=Root}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#1E63D6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{Binding ButtonCornerRadius, ElementName=Root}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#164FB1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#123F8E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ActionItemTemplate">
            <Grid x:Name="ItemRoot"
                  Width="{Binding ExpandedOuterWidth, ElementName=Root}"
                  HorizontalAlignment="Right"
                  Height="{Binding ButtonDiameter, ElementName=Root}">
                <Border x:Name="ExpandedRail"
                        Height="{Binding ExpandedHeight, ElementName=Root}"
                        Width="{Binding ExpandedWidth, ElementName=Root}"
                        HorizontalAlignment="Right"
                        Margin="8,0,8,0"
                        CornerRadius="{Binding ExpandedCornerRadius, ElementName=Root}"
                        Background="White"
                        BorderBrush="#D9DEE8"
                        BorderThickness="1"
                        Opacity="0"
                        IsHitTestVisible="False"
                        RenderTransformOrigin="1,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="0.55" ScaleY="0.96"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.16"/>
                    </Border.Effect>
                    <Grid x:Name="RailContentHost" Margin="12,0,52,0" VerticalAlignment="Center">
                        <ContentControl x:Name="ExpandedContentHost" Content="{Binding ExpandedContent}"/>
                        <TextBlock x:Name="LabelText" Text="{Binding Label}" FontWeight="SemiBold" Foreground="#263246" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <Button x:Name="ActionButton"
                        HorizontalAlignment="Right"
                        Content="{Binding Icon}"
                        Command="{Binding Command}"
                        CommandParameter="{Binding CommandParameter}"
                        IsEnabled="{Binding IsEnabled}"
                        ToolTip="{Binding Label}"
                        Style="{StaticResource ClusterRoundButton}"
                        Background="{Binding Background}"
                        Foreground="{Binding Foreground}"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding LabelDirection, ElementName=Root}" Value="Right">
                    <Setter TargetName="ItemRoot" Property="HorizontalAlignment" Value="Left"/>
                    <Setter TargetName="ExpandedRail" Property="HorizontalAlignment" Value="Left"/>
                    <Setter TargetName="ExpandedRail" Property="RenderTransformOrigin" Value="0,0.5"/>
                    <Setter TargetName="RailContentHost" Property="Margin" Value="52,0,12,0"/>
                    <Setter TargetName="ActionButton" Property="HorizontalAlignment" Value="Left"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ExpandedContent}" Value="{x:Null}">
                    <Setter TargetName="LabelText" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ExpandedContentHost" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <Trigger SourceName="ItemRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="ExpandedRail" Property="Opacity" Value="1"/>
                    <Setter TargetName="ExpandedRail" Property="IsHitTestVisible" Value="True"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ExpandedRail"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1"
                                                 Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ExpandedRail"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1"
                                                 Duration="0:0:0.20">
                                    <DoubleAnimation.EasingFunction>
                                        <QuinticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ExpandedRail"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1"
                                                 Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ExpandedRail"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0"
                                                 Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseIn"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ExpandedRail"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="0.55"
                                                 Duration="0:0:0.14">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseIn"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ExpandedRail"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="0.96"
                                                 Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseIn"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProfileSwitchActionViewModel}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox Width="60" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"/>
                <Button Content="切换" Command="{Binding ConfirmCommand}" Padding="4,2" Margin="4,0,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProfileRenameActionViewModel}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Width="62" Text="{Binding NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="确认" Command="{Binding ConfirmCommand}" Padding="4,2" Margin="4,0,0,0"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Width="{Binding ExpandedOuterWidth, ElementName=Root}"
            Height="{Binding ClusterHeight, ElementName=Root}">
        <ItemsControl x:Name="ActionsHost"
                      Width="{Binding ExpandedOuterWidth, ElementName=Root}"
                      Height="{Binding ClusterHeight, ElementName=Root}"
                      ItemsSource="{Binding Actions, ElementName=Root}"
                      ItemTemplate="{StaticResource ActionItemTemplate}"
                      IsHitTestVisible="False"
                      VerticalAlignment="Bottom">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="0"/>
                    <Setter Property="Canvas.Bottom" Value="0"/>
                    <Setter Property="Panel.ZIndex" Value="1"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <Button Content="{Binding MainContent, ElementName=Root}"
                HorizontalAlignment="{Binding ClusterHorizontalAlignment, ElementName=Root}"
                VerticalAlignment="Bottom"
                Panel.ZIndex="10"
                ToolTip="{Binding MainToolTip, ElementName=Root}"
                Style="{StaticResource ClusterRoundButton}"
                Background="{Binding MainBackground, ElementName=Root}"
                Foreground="{Binding MainForeground, ElementName=Root}"
                Click="OnMainButtonClick"/>
    </Grid>
</UserControl>
