<Window x:Class="HD2ModManager.Views.CrossArmorTransferCandidateOutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="生成跨护甲验证候选" Width="620" Height="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F5F6F8">
    <StackPanel Margin="20">
        <TextBlock Text="跨护甲验证候选" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Margin="0,10,0,8" Text="将按照当前计划重建 current target Unit 壳：已映射目标写入真实来源模型，其余目标 mesh 极小化。不会修改源 Mod、不会导入库、不会部署。" TextWrapping="Wrap" Foreground="#444"/>
        <Border Background="#EEF5FF" BorderBrush="#9CBDEB" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="材质绑定" FontWeight="SemiBold" Foreground="#234C7A"/>
                <ComboBox x:Name="MaterialBindingModeBox" Margin="0,6,0,4" SelectedIndex="0">
                    <ComboBoxItem Tag="PreserveSourceReferences" Content="直接沿用来源材质引用（推荐）"/>
                    <ComboBoxItem Tag="RequireCompleteSourceClosure" Content="仅使用完整材质闭包；其余回退目标材质"/>
                </ComboBox>
                <TextBlock Text="直接沿用会保留源 Patch 中现有的材质和贴图条目；缺少的外部贴图由已部署的资源提供包继续解析。" TextWrapping="Wrap" Foreground="#345D88"/>
            </StackPanel>
        </Border>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="OutputPathText" IsReadOnly="True" VerticalContentAlignment="Center" Padding="7"/>
            <Button Grid.Column="1" Content="浏览..." Width="82" Margin="8,0,0,0" Click="Browse_Click"/>
        </Grid>
        <TextBlock Text="输出根文件夹必须为空。" Foreground="#666"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" Width="88" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="生成候选" Width="100" IsDefault="True" Click="Confirm_Click"/>
        </StackPanel>
    </StackPanel>
</Window>