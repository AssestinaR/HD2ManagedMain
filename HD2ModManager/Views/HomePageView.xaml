<UserControl x:Class="HD2ModManager.Views.HomePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="480"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="0.54*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- Reserved for the first-run guide and other onboarding content. -->
        <Border Grid.Column="0" Style="{StaticResource CardContainer}" Padding="22">
            <StackPanel VerticalAlignment="Top">
                <Button Style="{StaticResource AppSecondaryButton}"
                        Content="列表组件测试"
                        HorizontalAlignment="Left"
                        Click="OnOpenModListPanelTestClick"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="2">
            <Border Style="{StaticResource CardContainer}"
                    Padding="18,14,18,54"
                    Margin="30,0,30,40"
                    VerticalAlignment="Bottom">
                <StackPanel>
                    <Grid Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Mod 库" Style="{StaticResource AppSupportingText}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding ModCount}" Style="{StaticResource AppStatusValue}" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Height="1" Margin="12,0" Background="{StaticResource StrokeSubtle}"/>
                    <Grid Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="已启用 Mod" Style="{StaticResource AppSupportingText}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding EnabledModCount}" Style="{StaticResource AppStatusValue}" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Height="1" Margin="12,0" Background="{StaticResource StrokeSubtle}"/>
                    <Grid Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="过时检测" Style="{StaticResource AppSupportingText}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding OutdatedModSummary}" Style="{StaticResource AppStatusValue}" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Height="1" Margin="12,0" Background="{StaticResource StrokeSubtle}"/>
                    <Grid Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Game Data" Style="{StaticResource AppSupportingText}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding GameDataHealth}"
                                   Style="{StaticResource AppStatusValue}"
                                   VerticalAlignment="Center"
                                   MaxWidth="160"
                                   TextAlignment="Right"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <Border Height="1" Margin="12,0" Background="{StaticResource StrokeSubtle}"/>
                    <Grid Height="40">
                        <Button Style="{StaticResource AppSecondaryButton}"
                                Content="检测并修复过时 Mod"
                                Command="{Binding RepairOutdatedModsCommand}"
                                Height="32"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Button Panel.ZIndex="1"
                    Style="{StaticResource AppPrimaryButton}"
                    Content="启动游戏"
                    Command="{Binding LaunchGameCommand}"
                    FontSize="36"
                    FontWeight="SemiBold"
                    Height="82"
                    VerticalAlignment="Bottom"
                    Margin="18,0,18,0"/>
        </Grid>
    </Grid>
</UserControl>
