<UserControl x:Class="HD2ModManager.Views.HomePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Transparent">
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
        <Border Style="{StaticResource CardContainer}" MinWidth="560" Padding="22">
            <StackPanel>
                <TextBlock Text="HD2 Mod Manager" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="新版工作区已启用：顶部切换页面，配置页与模组库可左右并排。" Foreground="#666" Margin="0,8,0,18"/>
                <UniformGrid Columns="2" Rows="6">
                    <TextBlock Text="当前配置" Foreground="#666" Margin="0,0,12,10"/>
                    <TextBlock Text="{Binding ActiveProfile}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="配置条目" Foreground="#666" Margin="0,0,12,10"/>
                    <TextBlock Text="{Binding ActiveProfileModSummary}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="模组数量" Foreground="#666" Margin="0,0,12,10"/>
                    <TextBlock Text="{Binding ModCount}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="配置数量" Foreground="#666" Margin="0,0,12,10"/>
                    <TextBlock Text="{Binding ProfileCount}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="导入队列" Foreground="#666" Margin="0,0,12,10"/>
                    <TextBlock Text="{Binding QueueSummary}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="最近应用" Foreground="#666" Margin="0,0,12,10"/>
                    <TextBlock Text="{Binding ApplySummary}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                </UniformGrid>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource CardContainer}" Margin="0,12,0,0" Padding="18">
            <StackPanel>
                <TextBlock Text="部署能力" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding DeploymentCapabilityText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding IsDeploymentBlocked}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Content="使用推荐 Mod 库" Command="{Binding MoveLibraryToRecommendedCommand}"/>
                    <Button Content="打开开发者设置" Command="{Binding OpenDeveloperSettingsCommand}" Margin="8,0,0,0"/>
                    <Button Content="以管理员身份重启" Command="{Binding RestartAsAdministratorCommand}" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
        </StackPanel>
    </Grid>
</UserControl>
