<Window x:Class="HD2ModManager.Views.CrossArmorTransferPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:analysis="clr-namespace:HD2ModAdaptation.Analysis;assembly=HD2ModAdaptation"
        Title="更换护甲 Mod — 只读计划" Width="1080" Height="720" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F5F6F8"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize" SizeToContent="Manual">
    <Window.Resources>
        <DataTemplate x:Key="SourcePartTemplate">
            <Grid Margin="3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PartKind}"/>
                <TextBlock Grid.Column="1" Text="{Binding Layer}"/>
                <TextBlock Grid.Column="2" Text="{Binding SemanticName}" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="TargetMappingTemplate">
            <Grid Margin="3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Target.PartKind}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Target.Layer}" Foreground="#666"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Target.SemanticName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Foreground="#666" TextWrapping="Wrap">
                        <Run Text="目标："/>
                        <Run Text="{Binding Target.BodyVariant}"/>
                        <Run Text=" / 大小 "/>
                        <Run Text="{Binding Target.StoredSizeText, Mode=OneWay}"/>
                        <Run Text=" / Unit " />
                        <Run Text="{Binding PhysicalTarget.UnitAssetKey.FileId, StringFormat=0x{0:x16}}"/>
                        <Run Text=" / mesh "/>
                        <Run Text="{Binding PhysicalTarget.MeshInfoIndex}"/>
                    </TextBlock>
                    <TextBlock Foreground="#2F5D8A" TextWrapping="Wrap">
                        <Run Text="来源："/>
                        <Run Text="{Binding Source.SemanticName, TargetNullValue=（极小化）}"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding Source.BodyVariant, TargetNullValue=-}"/>
                        <Run Text=" / Unit "/>
                        <Run Text="{Binding Source.UnitAssetKey.FileId, StringFormat=0x{0:x16}, TargetNullValue=-}"/>
                        <Run Text=" / mesh "/>
                        <Run Text="{Binding Source.MeshInfoIndex, TargetNullValue=-}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Reason}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding UsedByDisplayNames}" Foreground="#666" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="更换护甲 Mod：只读计划" FontSize="20" FontWeight="SemiBold"/>
        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="来源（源 Mod 中已出现的装备 archive）" FontWeight="SemiBold"/>
                <ComboBox Margin="0,6,0,8" ItemsSource="{Binding SourceChoices}" DisplayMemberPath="Display" SelectedValuePath="Entry" SelectedValue="{Binding SelectedSource}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="来源身形" FontWeight="SemiBold"/>
                        <ComboBox Margin="0,6,6,0" SelectedValuePath="Tag" SelectedValue="{Binding SelectedSourceBodyVariant}">
                            <ComboBoxItem Content="任意" Tag="{x:Static analysis:UnitMeshBodyVariant.Any}" IsSelected="True"/>
                            <ComboBoxItem Content="Slim" Tag="{x:Static analysis:UnitMeshBodyVariant.Slim}"/>
                            <ComboBoxItem Content="Stocky" Tag="{x:Static analysis:UnitMeshBodyVariant.Stocky}"/>
                        </ComboBox></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="优先身形" FontWeight="SemiBold"/>
                        <ComboBox Margin="0,6,6,0" SelectedValuePath="Tag" SelectedValue="{Binding BodyVariantPreference}">
                            <ComboBoxItem Content="Slim 优先" Tag="Slim" IsSelected="True"/>
                            <ComboBoxItem Content="Stocky 优先" Tag="Stocky"/>
                        </ComboBox></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="优先层级" FontWeight="SemiBold"/>
                        <ComboBox Margin="0,6,0,0" SelectedValuePath="Tag" SelectedValue="{Binding LayerPreference}">
                            <ComboBoxItem Content="护甲优先" Tag="Armor" IsSelected="True"/>
                            <ComboBoxItem Content="内层优先" Tag="Undergarment"/>
                            <ComboBoxItem Content="附件优先" Tag="Accessory"/>
                        </ComboBox></StackPanel>
                    </Grid>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="目标装备（可多选）" FontWeight="SemiBold"/>
                <ListBox Margin="0,6,0,0" Height="105" ItemsSource="{Binding TargetChoices}">
                    <ListBox.ItemTemplate>
                        <DataTemplate><CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected}"/></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#D5D8DE" BorderThickness="1" CornerRadius="5" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="来源可见部件" FontSize="16" FontWeight="SemiBold"/>
                    <ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding SourceParts}" ItemTemplate="{StaticResource SourcePartTemplate}"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#D5D8DE" BorderThickness="1" CornerRadius="5" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="目标预测（替换或极小化）" FontSize="16" FontWeight="SemiBold"/>
                    <ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding TargetMappings}" ItemTemplate="{StaticResource TargetMappingTemplate}">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="强制来源..." Click="ForceSource_Click"/>
                                <MenuItem Header="取消强制映射" Click="ClearForcedMapping_Click"/>
								<MenuItem Header="禁用自动替换并极小化" Click="SuppressAutomaticMapping_Click"/>
								<MenuItem Header="恢复自动规划" Click="RestoreAutomaticMapping_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <TextBlock Grid.Row="2" Margin="0,10,0,0" Text="{Binding Summary}" TextWrapping="Wrap" Foreground="#444"/>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Issues}" Foreground="#A02323" TextWrapping="Wrap"/>
				<CheckBox Content="允许手动调整目标映射（右键目标条目）" IsChecked="{Binding AllowManualMappings}" Margin="0,6,0,0"/>
                <TextBlock Margin="0,4,0,0" Text="本窗口不会写出 Patch、不会修改源 Mod 或库。确认计划后，下一阶段才会启用输出。" Foreground="#666" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="刷新预览" Width="92" Margin="0,0,8,0" Command="{Binding RefreshPlanCommand}"/>
				<Button Content="导出 JSON..." Width="104" Margin="0,0,8,0" Click="ExportJson_Click"/>
                <Button Content="生成验证候选..." Width="122" Margin="0,0,8,0" IsEnabled="{Binding CanGenerateCandidate}" Click="GenerateCandidate_Click"/>
                <Button Content="关闭" Width="88" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
