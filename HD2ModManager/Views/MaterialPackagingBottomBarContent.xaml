<UserControl x:Class="HD2ModManager.Views.MaterialPackagingBottomBarContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsOutput, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="输出位置：" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Style="{StaticResource AppTextBox}" Width="360" Text="{Binding Operation.OutputDirectory, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Style="{StaticResource AppSecondaryButton}" Content="浏览" Command="{Binding Operation.BrowseCommand}" Margin="8,0,0,0"/>
            <Button Style="{StaticResource AppPrimaryButton}" Content="生成" Command="{Binding Operation.GenerateCommand}" Margin="8,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsOptions, Converter={StaticResource BoolToVis}}">
            <CheckBox Style="{StaticResource AppCheckBox}" Content="只集成引用目标" IsChecked="{Binding Operation.OnlyReferencedAssets}" Margin="0,0,18,0" Visibility="{Binding Operation.RequiresCandidate, Converter={StaticResource BoolToVis}}"/>
            <CheckBox Style="{StaticResource AppCheckBox}" Content="替换内置材质" IsChecked="{Binding Operation.ReplaceExistingMaterials}" Margin="0,0,18,0" Visibility="{Binding Operation.RequiresCandidate, Converter={StaticResource BoolToVis}}"/>
            <CheckBox Style="{StaticResource AppCheckBox}" Content="自动导入 Mod 库" IsChecked="{Binding Operation.ImportToLibrary}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsCandidates, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="材质包候选：" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Style="{StaticResource AppCompactComboBox}" Width="360" ItemsSource="{Binding Operation.CandidateOptions}" SelectedItem="{Binding Operation.SelectedCandidate, Mode=TwoWay}" DisplayMemberPath="Name"/>
        </StackPanel>
    </Grid>
</UserControl>
