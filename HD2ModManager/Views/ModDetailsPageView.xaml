<UserControl x:Class="HD2ModManager.Views.ModDetailsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HD2ModManager.Views">
    <UserControl.Resources>
        <local:ImagePlaceholderConverter x:Key="ImagePlaceholder"/>
    </UserControl.Resources>
    <ScrollViewer Background="Transparent">
        <StackPanel>
            <Border Style="{StaticResource CardContainer}" Margin="{StaticResource CardStackMargin}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="96" Height="96" CornerRadius="14" ClipToBounds="True" Background="#EEF1F6" Margin="0,0,16,0">
                        <Image Source="{Binding Image, Converter={StaticResource ImagePlaceholder}, ConverterParameter=160}" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding TagsString}" Foreground="#1E63D6" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SourcePath}" Foreground="#777" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardContainer}" Margin="{StaticResource CardStackMargin}">
                <StackPanel>
                    <TextBlock Text="备注" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding Description}" Foreground="#555" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardContainer}" Margin="{StaticResource CardStackMargin}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="Patch 文件组" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left"/>
                        <TextBlock Text="{Binding FileGroupCount, StringFormat=共 {0} 组}" Foreground="#777" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <TextBlock Text="{Binding PatchSummary}" FontFamily="Consolas" Foreground="#444" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardContainer}" Margin="{StaticResource CardStackMargin}">
                <StackPanel>
                    <TextBlock Text="当前配置状态" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding ProfileStatus}" Foreground="#444" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardContainer}" Margin="{StaticResource CardStackMargin}">
                <StackPanel>
                    <TextBlock Text="资产标签" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding AssetTagsString}" FontFamily="Consolas" Foreground="#444" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardContainer}" Margin="{StaticResource CardStackMargin}">
                <StackPanel>
                    <TextBlock Text="替换资产" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding AssetListSummary}" FontFamily="Consolas" Foreground="#444" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardContainer}" Margin="{StaticResource CardStackMargin}">
                <StackPanel>
                    <TextBlock Text="资产覆盖" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding AssetOverrideSummary}" Foreground="#444" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardContainer}" Margin="{StaticResource CardStackMargin}">
                <StackPanel>
                    <TextBlock Text="文件完整性" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding FileIntegritySummary}" FontFamily="Consolas" Foreground="#444" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardContainer}">
                <StackPanel>
                    <TextBlock Text="当前配置冲突" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding ConflictSummary}" Foreground="#444" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="加入配置" Command="{Binding AddToProfileCommand}" Padding="14,6"/>
                <Button Content="编辑标签" Command="{Binding EditTagsCommand}" Padding="14,6" Margin="8,0,0,0"/>
                <Button Content="删除" Command="{Binding DeleteCommand}" Padding="14,6" Margin="8,0,0,0" Foreground="#B3261E"/>
                <Button Content="打开文件夹" Command="{Binding OpenFolderCommand}" Padding="14,6"/>
                <Button Content="刷新" Command="{Binding RefreshCommand}" Padding="14,6" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
