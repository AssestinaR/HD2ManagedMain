<UserControl x:Class="HD2ModManager.Views.TagEditPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Background="Transparent">
        <Border DockPanel.Dock="Top" Style="{StaticResource CardContainer}" Margin="{StaticResource CardStackMargin}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="标签编辑" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text=" - " FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="{Binding Current.Name}" FontSize="18" FontWeight="Bold" Width="480" TextTrimming="CharacterEllipsis"/>
                <TextBox x:Name="QueryBox" Width="240" Margin="12,0,0,0" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="保存" Margin="8,0,0,0" Command="{Binding SaveAndNextCommand}"/>
                <Button Content="新增" Margin="8,0,0,0" Click="OnAddCustomTag"/>
            </StackPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Header="已选标签" Grid.Column="0" Padding="6">
                <ListBox ItemsSource="{Binding Tags}" SelectionMode="Single" PreviewMouseLeftButtonUp="OnSelectedTagClick"/>
            </GroupBox>
            <Grid Grid.Column="1"/>
            <GroupBox Header="可选标签" Grid.Column="2" Padding="6">
                <ListBox ItemsSource="{Binding AvailableTags}" SelectionMode="Single" PreviewMouseLeftButtonUp="OnAvailableTagClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </Grid>
    </DockPanel>
</UserControl>