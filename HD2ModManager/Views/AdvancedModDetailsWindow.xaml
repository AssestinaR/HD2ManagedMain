<Window x:Class="HD2ModManager.Views.AdvancedModDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="高级 Mod 详情" Width="920" Height="720" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="#F5F6F8">
    <ScrollViewer Margin="16">
        <StackPanel>
            <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="仅用于作者与诊断。扫描事实不可直接编辑。" Foreground="#777" Margin="0,4,0,14"/>
            <Border Style="{StaticResource CardContainer}" Margin="0,0,0,10">
                <StackPanel><TextBlock Text="源 Patch 组" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding PatchSummary}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
            </Border>
            <Border Style="{StaticResource CardContainer}" Margin="0,0,0,10">
                <StackPanel><TextBlock Text="替换资产与 Game Data 目标" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding AssetListSummary}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
            </Border>
            <Border Style="{StaticResource CardContainer}" Margin="0,0,0,10">
                <StackPanel><TextBlock Text="配置预计覆盖" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding AssetOverrideSummary}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
            </Border>
            <Border Style="{StaticResource CardContainer}" Margin="0,0,0,10">
                <StackPanel><TextBlock Text="文件与解析诊断" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding FileIntegritySummary}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
            </Border>
            <Border Style="{StaticResource CardContainer}">
                <StackPanel><TextBlock Text="潜在重叠" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding ConflictSummary}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
