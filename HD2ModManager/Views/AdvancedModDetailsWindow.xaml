<Window x:Class="HD2ModManager.Views.AdvancedModDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="高级 Mod 详情" Width="1500" Height="820" MinWidth="1000" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F5F6F8">
    <ScrollViewer Margin="16">
        <StackPanel>
            <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="稳定资产事实只读展示；Profile 状态和诊断为当前配置投影。" Foreground="#777" Margin="0,4,0,10"/>
            <Border Style="{StaticResource CardContainer}" Margin="0,0,0,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <CheckBox Content="仅异常" IsChecked="{Binding AdvancedOnlyIssues, Mode=TwoWay}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBox Text="{Binding AdvancedAssetQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索类型、AssetKey、名称或目标" Padding="8"/>
                </DockPanel>
            </Border>
            <TextBlock Text="{Binding AdvancedAssetState}" Foreground="#666" Margin="2,0,0,8"/>
            <Border Style="{StaticResource CardContainer}" Padding="0" Margin="0,0,0,10">
                <DataGrid ItemsSource="{Binding AdvancedAssets}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MinHeight="360">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="类型" Binding="{Binding TypeName}" Width="110"/>
                        <DataGridTextColumn Header="AssetKey" Binding="{Binding AssetKeyText}" Width="250"/>
                        <DataGridTextColumn Header="资源名称" Binding="{Binding ResourceName}" Width="180"/>
						<DataGridTextColumn Header="部件" Binding="{Binding PartSummary}" Width="210"/>
                        <DataGridTextColumn Header="目标" Binding="{Binding TargetSummary}" Width="220"/>
                        <DataGridTextColumn Header="引用关系" Binding="{Binding ReferenceSummary}" Width="150"/>
                        <DataGridTextColumn Header="Profile 状态" Binding="{Binding ProfileStatus}" Width="170"/>
                        <DataGridTextColumn Header="诊断" Binding="{Binding DiagnosticSummary}" Width="260"/>
                        <DataGridTextColumn Header="Patch 文件组" Binding="{Binding PatchGroupSummary}" Width="180"/>
                        <DataGridTextColumn Header="Toc" Binding="{Binding TocBytes}" Width="80"/>
                        <DataGridTextColumn Header="Stream" Binding="{Binding StreamBytes}" Width="80"/>
                        <DataGridTextColumn Header="GPU" Binding="{Binding GpuBytes}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Style="{StaticResource CardContainer}" Margin="0,0,0,10">
                <StackPanel><TextBlock Text="文件与解析诊断" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding FileIntegritySummary}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
            </Border>
            <Border Style="{StaticResource CardContainer}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="材质打包" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding MaterialDeliverySummary}" TextWrapping="Wrap" Foreground="#255A3A" Margin="0,8,0,8"/>
                    <TextBlock Text="{Binding MaterialPackagingSummary}" TextWrapping="Wrap" Foreground="#555" Margin="0,8,0,12"/>
                    <WrapPanel>
                        <Button Content="拆分内嵌材质" ToolTip="生成模型包与材质包两个普通 Mod" Command="{Binding SplitEmbeddedMaterialsCommand}" Padding="12,7" Margin="0,0,8,8"/>
                        <Button Content="用材质包生成替换版" ToolTip="选择完整适配的库内材质包，并生成新的内嵌 Mod" Command="{Binding ReplaceEmbeddedMaterialsCommand}" Padding="12,7" Margin="0,0,8,8"/>
                        <Button Content="用材质包生成内嵌版" ToolTip="为外部材质模型选择完整适配材质包，并生成内嵌 Mod" Command="{Binding EmbedExternalMaterialsCommand}" Padding="12,7" Margin="0,0,8,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardContainer}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="更新 Unit 为当前版本（正式验证候选）" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="读取 source/current target Unit 并生成独立候选副本，不修改源 Mod。操作仅更新失效 Unit，原样保留其余 Patch 条目与 sidecar；不检测、拆分或合并材质。生成成功仅表示内部结构检查完成；请在 Blender 或游戏中完成外部验证。" TextWrapping="Wrap" Foreground="#666" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding SameKeyReconstructionSummary}" TextWrapping="Wrap" Foreground="#255A3A" Margin="0,8,0,12"/>
                    <WrapPanel>
                        <Button Content="更新 Unit（保持其余资源）..." ToolTip="仅替换旧 Unit/关联旧 Composite，并保留其他资源与 sidecar" Command="{Binding RebuildSameKeyCommand}" Padding="12,7" Margin="0,0,8,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
