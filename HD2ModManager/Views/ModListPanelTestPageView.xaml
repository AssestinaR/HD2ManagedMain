<UserControl x:Class="HD2ModManager.Views.ModListPanelTestPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HD2ModManager.Views">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource CardContainer}" Padding="14">
            <StackPanel>
                <TextBlock Text="列表布局测试" Style="{StaticResource AppCardTitle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource AppSecondaryButton}" Content="新增条目" Command="{Binding AddCommand}"/>
                    <Button Style="{StaticResource AppSecondaryButton}" Content="移除末项" Command="{Binding RemoveCommand}" Margin="8,0,0,0"/>
                    <Button Style="{StaticResource AppSecondaryButton}" Content="末项移到首项" Command="{Binding MoveLastToFirstCommand}" Margin="8,0,0,0"/>
                    <Button Style="{StaticResource AppHeaderTextButton}" Content="3 项" Command="{Binding UseShortListCommand}" Margin="12,0,0,0"/>
                    <Button Style="{StaticResource AppHeaderTextButton}" Content="14 项" Command="{Binding UseLongListCommand}" Margin="6,0,0,0"/>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource AppSupportingText}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding LastAction}" Style="{StaticResource AppSupportingText}" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="340"/>
                </Grid.RowDefinitions>
                <TextBlock Text="固定高度：内置滚动" Style="{StaticResource AppCardTitle}"/>
                <local:ModListPanel Grid.Row="2"
                                    ItemsSource="{Binding Items}"
                                    HeaderTitle="固定高度列表"
                                    HeaderSummary="条目超出时应由列表内部滚动。"
                                    SelectionPolicy="Multiple"
                                    RowActions="Details, Rename"
                                    SelectionRequested="OnSelectionRequested"
                                    RowActionInvoked="OnRowActionInvoked"/>
            </Grid>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="内容自适应：外层滚动" Style="{StaticResource AppCardTitle}"/>
                    <local:ModListPanel ItemsSource="{Binding Items}"
                                        HeaderTitle="内容撑高列表"
                                        HeaderSummary="禁用内部滚动条后，列表应随条目数量增长。"
                                        VerticalScrollBarVisibility="Disabled"
                                        SelectionPolicy="Multiple"
                                        RowActions="Details, Rename"
                                        SelectionRequested="OnSelectionRequested"
                                        RowActionInvoked="OnRowActionInvoked"
                                        Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
