<UserControl x:Class="HD2ModManager.Views.StatusPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
            <Border Style="{StaticResource CardContainer}" MinWidth="560" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="状态" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <UniformGrid Columns="2" Rows="10">
                    <TextBlock Text="当前配置" Foreground="#666" Margin="0,0,12,10"/>
                    <TextBlock Text="{Binding ActiveProfile}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="配置条目" Foreground="#666" Margin="0,0,12,10"/>
                    <TextBlock Text="{Binding ProfileEntrySummary}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="冲突检测" Foreground="#666" Margin="0,0,12,10"/>
                    <TextBlock Text="{Binding ConflictSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="模组数量" Foreground="#666" Margin="0,0,12,10"/>
                    <TextBlock Text="{Binding ModCount}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="配置数量" Foreground="#666" Margin="0,0,12,10"/>
                    <TextBlock Text="{Binding ProfileCount}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="导入队列" Foreground="#666" Margin="0,0,12,10"/>
                    <TextBlock Text="{Binding QueueSummary}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="Mods Root" Foreground="#666" Margin="0,0,12,10"/>
                    <TextBlock Text="{Binding ModsRoot}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="Game Data" Foreground="#666" Margin="0,0,12,10"/>
                    <TextBlock Text="{Binding GameDataFolder}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="最近应用时间" Foreground="#666" Margin="0,0,12,10"/>
                    <TextBlock Text="{Binding LastAppliedUtc}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="最近应用结果" Foreground="#666" Margin="0,0,12,10"/>
                    <TextBlock Text="{Binding ApplySummary}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    </UniformGrid>
                    <ItemsControl ItemsSource="{Binding ApplyDetails}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#555" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="刷新状态" Command="{Binding RefreshCommand}" Width="100" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardContainer}" MinWidth="560" Padding="18">
                <StackPanel>
                    <TextBlock Text="资产索引状态" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <UniformGrid Columns="2" Rows="6">
                        <TextBlock Text="状态" Foreground="#666" Margin="0,0,12,10"/>
                        <TextBlock Text="{Binding AssetIndexState}" FontWeight="SemiBold" Foreground="#1E63D6" Margin="0,0,0,10"/>
                        <TextBlock Text="摘要" Foreground="#666" Margin="0,0,12,10"/>
                        <TextBlock Text="{Binding AssetIndexSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="构建时间" Foreground="#666" Margin="0,0,12,10"/>
                        <TextBlock Text="{Binding AssetIndexBuiltUtc}" Margin="0,0,0,10"/>
                        <TextBlock Text="索引目录" Foreground="#666" Margin="0,0,12,10"/>
                        <TextBlock Text="{Binding AssetIndexGameData}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Text="索引内容" Foreground="#666" Margin="0,0,12,10"/>
                        <TextBlock Text="{Binding AssetIndexCounts}" Margin="0,0,0,10"/>
                        <TextBlock Text="资产元数据" Foreground="#666" Margin="0,0,12,10"/>
                        <TextBlock Text="{Binding AssetMetadataStatus}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    </UniformGrid>
                    <TextBlock Text="{Binding AssetIndexHint}" Foreground="#666" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="建立/重建资产索引" Command="{Binding BuildAssetIndexCommand}" Width="150" HorizontalAlignment="Left"/>
                        <Button Content="刷新状态" Command="{Binding RefreshCommand}" Width="100" HorizontalAlignment="Left" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
