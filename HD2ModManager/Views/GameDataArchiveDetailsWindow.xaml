<Window x:Class="HD2ModManager.Views.GameDataArchiveDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameData 对象详情" Width="1180" Height="720" MinWidth="860" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="#F5F6F8">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource CardContainer}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="Display name" Foreground="#666"/><TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" Cursor="Hand" MouseLeftButtonUp="OnCopyField" Tag="DisplayName"/>
                <TextBlock Grid.Column="2" Text="Package" Foreground="#666"/><TextBlock Grid.Column="3" Text="{Binding PackageName}" Cursor="Hand" MouseLeftButtonUp="OnCopyField" Tag="PackageName"/>
                <TextBlock Grid.Row="1" Text="Category" Foreground="#666" Margin="0,8,0,0"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Category}" Margin="0,8,0,0" Cursor="Hand" MouseLeftButtonUp="OnCopyField" Tag="Category"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="替换状态" Foreground="#666" Margin="0,8,0,0"/><TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding ReplacementStatus}" Margin="0,8,0,0" Cursor="Hand" MouseLeftButtonUp="OnCopyField" Tag="ReplacementStatus"/>
                <TextBlock Grid.Row="2" Text="生效的 patch 组" Foreground="#666" Margin="0,8,0,0"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EffectivePatchGroup}" Margin="0,8,0,0" Cursor="Hand" MouseLeftButtonUp="OnCopyField" Tag="EffectivePatchGroup"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="生效的 Mod" Foreground="#666" Margin="0,8,0,0"/><TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding EffectiveMod}" Margin="0,8,0,0" Cursor="Hand" MouseLeftButtonUp="OnCopyField" Tag="EffectiveMod"/>
            </Grid>
        </Border>
        <TextBlock Grid.Row="1" Text="{Binding ContentSummary}" FontWeight="SemiBold" Margin="4,12"/>
        <Border Grid.Row="2" Style="{StaticResource CardContainer}" Padding="0">
            <ListView ItemsSource="{Binding Assets}" KeyDown="OnAssetsKeyDown">
                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><EventSetter Event="MouseDoubleClick" Handler="OnAssetDoubleClick"/></Style></ListView.ItemContainerStyle>
                <ListView.View><GridView>
                    <GridViewColumn Header="类型" Width="120" DisplayMemberBinding="{Binding TypeName}"/>
                    <GridViewColumn Header="Hash" Width="285" DisplayMemberBinding="{Binding Hash}"/>
                    <GridViewColumn Header="Friendly name" Width="210" DisplayMemberBinding="{Binding FriendlyName}"/>
					<GridViewColumn Header="部件" Width="210" DisplayMemberBinding="{Binding PartSummary}"/>
                    <GridViewColumn Header="覆盖生效的 patch 组" Width="190" DisplayMemberBinding="{Binding EffectivePatchGroup}"/>
                    <GridViewColumn Header="覆盖生效的 Mod" Width="170" DisplayMemberBinding="{Binding EffectiveMod}"/>
                    <GridViewColumn Header="同 AssetKey 的其他 Package" Width="190"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SharedPackagesText}" ToolTip="{Binding SharedPackagesTooltip}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                    <GridViewColumn Header="同 AssetKey 的其他对象" Width="190"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SharedObjectsText}" ToolTip="{Binding SharedObjectsTooltip}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                </GridView></ListView.View>
            </ListView>
        </Border>
        <TextBlock Grid.Row="3" Text="{Binding CopyStatus}" Foreground="#166534" Margin="4,10,0,0"/>
    </Grid>
</Window>
