<UserControl x:Class="HD2ModManager.Views.GameDataArchiveDetailsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid DataContext="{Binding Details}">
        <Grid.RowDefinitions><RowDefinition Height="210"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource CardContainer}" Margin="{StaticResource CardStackMargin}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="对象" Style="{StaticResource AppSupportingText}"/><TextBlock Grid.Column="1" Text="{Binding DisplayName}" Style="{StaticResource AppStatusValue}" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Text="Package" Style="{StaticResource AppSupportingText}" Margin="0,5,0,0"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PackageName}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="2" Text="分类" Style="{StaticResource AppSupportingText}" Margin="0,5,0,0"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Category}" Margin="0,5,0,0"/>
                <TextBlock Grid.Row="3" Text="替换状态" Style="{StaticResource AppSupportingText}" Margin="0,5,0,0"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ReplacementStatus}" Margin="0,5,0,0"/>
                <TextBlock Grid.Row="4" Text="生效组" Style="{StaticResource AppSupportingText}" Margin="0,5,0,0"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding EffectivePatchGroup}" Margin="0,5,0,0"/>
                <TextBlock Grid.Row="5" Text="生效 Mod" Style="{StaticResource AppSupportingText}" Margin="0,5,0,0"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding EffectiveMod}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,8,0,0">
                    <TextBlock Text="{Binding ContentSummary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding CopyStatus}" Foreground="#166534" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <TextBox Style="{StaticResource AppSearchBox}" Width="145" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索类型、Hash、对象、部件、生效 Mod 或共享项"/>
                    <ComboBox Style="{StaticResource AppCompactComboBox}" Width="96" ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding TypeFilter}" Margin="8,0,0,0"/>
                    <ComboBox Style="{StaticResource AppCompactComboBox}" Width="88" ItemsSource="{Binding ReplacementFilters}" SelectedItem="{Binding ReplacementFilter}" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource DataTableCard}">
            <DataGrid Style="{StaticResource DataTableGrid}" ItemsSource="{Binding AssetsView}" ContextMenuOpening="OnAssetContextMenuOpening">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="复制完整 AssetKey 信息" Click="OnCopyAssetMenuItemClick"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
                        <Setter Property="ToolTip">
                            <Setter.Value>
                                <ToolTip>
                                    <StackPanel MaxWidth="560">
                                        <TextBlock Text="{Binding TypeName, StringFormat=类型：{0}}"/>
                                        <TextBlock Text="{Binding Hash, StringFormat=Hash：{0}}"/>
                                        <TextBlock Text="{Binding FriendlyName, StringFormat=对象：{0}}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding PartSummary, StringFormat=部件：{0}}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding EffectivePatchGroup, StringFormat=生效 patch 组：{0}}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding EffectiveMod, StringFormat=生效 Mod：{0}}" TextWrapping="Wrap"/>
                                        <TextBlock Text="共享 Package："/>
                                        <TextBlock Text="{Binding SharedPackagesFullText}" TextWrapping="Wrap" Margin="8,0,0,0"/>
                                        <TextBlock Text="共享对象：" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding SharedObjectsFullText}" TextWrapping="Wrap" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </ToolTip>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="类型" Binding="{Binding TypeName}" Width="0.9*"/>
                    <DataGridTextColumn Header="Hash" Binding="{Binding Hash}" Width="1.8*"/>
                    <DataGridTextColumn Header="对象" Binding="{Binding FriendlyName}" Width="1.25*"/>
                    <DataGridTextColumn Header="部件" Binding="{Binding PartSummary}" Width="1.25*"/>
                    <DataGridTextColumn Header="生效组" Binding="{Binding EffectivePatchGroup}" Width="1.1*"/>
                    <DataGridTextColumn Header="生效 Mod" Binding="{Binding EffectiveMod}" Width="1.05*"/>
                    <DataGridTextColumn Header="共享 Package" Binding="{Binding SharedPackagesText}" Width="1.15*"/>
                    <DataGridTextColumn Header="共享对象" Binding="{Binding SharedObjectsText}" Width="1.15*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>