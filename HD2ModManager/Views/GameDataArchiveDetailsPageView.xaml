<UserControl x:Class="HD2ModManager.Views.GameDataArchiveDetailsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid DataContext="{Binding Details}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource CardContainer}" Margin="{StaticResource CardStackMargin}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="对象" Foreground="#666"/><TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Text="Package" Foreground="#666" Margin="0,5,0,0"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PackageName}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="2" Text="分类" Foreground="#666" Margin="0,5,0,0"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Category}" Margin="0,5,0,0"/>
                <TextBlock Grid.Row="3" Text="替换状态" Foreground="#666" Margin="0,5,0,0"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ReplacementStatus}" Margin="0,5,0,0"/>
                <TextBlock Grid.Row="4" Text="生效组" Foreground="#666" Margin="0,5,0,0"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding EffectivePatchGroup}" Margin="0,5,0,0"/>
                <TextBlock Grid.Row="5" Text="生效 Mod" Foreground="#666" Margin="0,5,0,0"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding EffectiveMod}" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </Grid>
        </Border>
        <TextBlock Grid.Row="1" Text="{Binding ContentSummary}" FontWeight="SemiBold" Margin="4,0,4,8" TextWrapping="Wrap"/>
        <Border Grid.Row="2" Style="{StaticResource DataTableCard}">
            <DataGrid Style="{StaticResource DataTableGrid}" ItemsSource="{Binding Assets}" MouseDoubleClick="OnAssetDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="类型" Binding="{Binding TypeName}" Width="0.9*"/>
                    <DataGridTextColumn Header="Hash" Binding="{Binding Hash}" Width="1.8*"/>
                    <DataGridTextColumn Header="对象" Binding="{Binding FriendlyName}" Width="1.25*"/>
                    <DataGridTextColumn Header="部件" Binding="{Binding PartSummary}" Width="1.25*"/>
                    <DataGridTextColumn Header="生效组" Binding="{Binding EffectivePatchGroup}" Width="1.1*"/>
                    <DataGridTextColumn Header="生效 Mod" Binding="{Binding EffectiveMod}" Width="1.05*"/>
                    <DataGridTextColumn Header="共享 Package" Binding="{Binding SharedPackagesText}" Width="1.15*"/>
                    <DataGridTextColumn Header="共享对象" Binding="{Binding SharedObjectsText}" Width="1.15*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <TextBlock Grid.Row="3" Text="{Binding CopyStatus}" Foreground="#166534" Margin="4,8,0,0"/>
    </Grid>
</UserControl>