<UserControl x:Class="HD2ModManager.Views.NavCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="74.556" d:DesignWidth="277.87">
    <Button Command="{Binding NavigateCommand}"
            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" FocusVisualStyle="{x:Null}">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <ContentPresenter/>
            </ControlTemplate>
        </Button.Template>
        <Border Style="{DynamicResource CardContainer}" Width="260">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Icon placeholder -->
                <Rectangle Grid.RowSpan="2" Width="40" Height="40" Fill="#E0E0E0" Stroke="#C8C8C8" RadiusX="6" RadiusY="6"/>
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Description}" Foreground="#666" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <!-- Chevron indicator -->
                <TextBlock Grid.Column="2" Grid.RowSpan="2" Text=">" Foreground="#888" FontSize="16" VerticalAlignment="Center" Margin="8,0,2,0"/>
            </Grid>
        </Border>
    </Button>
</UserControl>
