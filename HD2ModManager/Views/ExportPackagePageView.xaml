<UserControl x:Class="HD2ModManager.Views.ExportPackagePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HD2ModManager.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:BooleanInverseToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <local:ImagePlaceholderConverter x:Key="ImagePlaceholder"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource CardContainer}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="导出 Mod" Style="{StaticResource AppCardTitle}"/>
                            <TextBlock Text="生成社区通用的 root / option / suboption 包结构。" Style="{StaticResource AppSupportingText}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource AppPrimaryButton}" Content="生成 ZIP" Command="{Binding ExportCommand}" MinWidth="86"/>
                    </DockPanel>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="包名称" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Style="{StaticResource AppTextBox}" Text="{Binding PackageName, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="输出目录" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Style="{StaticResource AppTextBox}" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Style="{StaticResource AppSecondaryButton}" Content="浏览" Click="OnBrowseOutputClick" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{Binding State}" Style="{StaticResource AppSupportingText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource CardContainer}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="14,12,14,8">
                        <TextBlock Text="导出结构" Style="{StaticResource AppCardTitle}" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource AppSecondaryButton}" Content="添加选项" Command="{Binding AddOptionCommand}"/>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" local:SmoothScrollBehavior.IsEnabled="True">
                        <ItemsControl ItemsSource="{Binding Rows}" Margin="10,0,10,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource StrokeSubtle}" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="9" Margin="0,0,0,7">
                                        <Border.Style>
                                            <Style TargetType="Border"><Setter Property="Background" Value="{StaticResource SurfaceCard}"/><Style.Triggers><DataTrigger Binding="{Binding IsAwaitingSelection}" Value="True"><Setter Property="Background" Value="{StaticResource SurfaceInteractiveHover}"/><Setter Property="BorderBrush" Value="{StaticResource StrokeFocus}"/></DataTrigger></Style.Triggers></Style>
                                        </Border.Style>
                                        <Grid Margin="{Binding Indent, Converter={x:Static local:IndentMarginConverter.Instance}}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding KindText}" Style="{StaticResource AppSupportingText}" Width="38"/>
                                                <Image Width="26" Height="26" Source="{Binding ImagePath, Converter={StaticResource ImagePlaceholder}, ConverterParameter=72}" Stretch="UniformToFill"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBox Style="{StaticResource AppTextBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBox Style="{StaticResource AppTextBox}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" FontSize="12"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <Button Style="{StaticResource AppSecondaryButton}" Content="选择" Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource AppSecondaryButton}" Content="清除" Command="{Binding DataContext.ClearCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="5,0,0,0"/>
                                                <Button Style="{StaticResource AppSecondaryButton}" Content="图像" Click="OnEditImageClick" Tag="{Binding}" Margin="5,0,0,0"/>
                                                <Button Style="{StaticResource AppSecondaryButton}" Content="+ 子项" Command="{Binding DataContext.AddSubOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="5,0,0,0" Visibility="{Binding CanAddSubOption, Converter={StaticResource BoolToVis}}"/>
                                                <Button Style="{StaticResource AppSecondaryButton}" Content="删除" Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="5,0,0,0" Visibility="{Binding IsRoot, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <local:ModListPanel Grid.Column="2"
                            HeaderTitle="可选来源 Mod"
                            HeaderSummary="{Binding CandidateSummary}"
                            EmptyMessage="{Binding CandidatePlaceholder}"
                            ItemsSource="{Binding Candidates}"
                            SearchText="{Binding CandidateQuery, UpdateSourceTrigger=PropertyChanged}"
                            SelectionPolicy="Single"
                            ShowSelectionCheckbox="True"
                            SelectionRequested="OnCandidateSelectionRequested"/>
    </Grid>
</UserControl>
