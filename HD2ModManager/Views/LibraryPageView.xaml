<UserControl x:Class="HD2ModManager.Views.LibraryPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HD2ModManager.Views"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:BooleanInverseToVisibilityConverter x:Key="BoolInverseToVis"/>
        <local:CompactWidthConverter x:Key="CompactToWidth"/>
        <local:CompactMinHeightConverter x:Key="CompactToMinHeight"/>
        <local:StringNotEmptyToVisibilityConverter x:Key="StrNotEmptyToVis"/>
        <local:ImagePlaceholderConverter x:Key="ImagePlaceholder"/>
    </UserControl.Resources>
    <DockPanel>
        <!-- Top controls -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <TextBlock Text="Library" FontSize="18" FontWeight="Bold"/>
            <TextBox Width="240" Margin="12,0,0,0" x:Name="QueryBox"/>
            <Button Content="Search" Margin="8,0,0,0" Click="OnSearch"/>
            <ToggleButton Content="Compact" Margin="12,0,0,0" IsChecked="{Binding IsCompact}"/>
        </StackPanel>
        <Separator DockPanel.Dock="Top" Margin="0,4"/>
        <!-- Segmented card area -->
        <ScrollViewer>
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <GroupBox Header="{Binding Title}" Margin="8,4" Visibility="{Binding HasContent, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding Subsections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Visibility="{Binding HasContent, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="8,4"/>
                                                <ItemsControl ItemsSource="{Binding Mods}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="6" Padding="8" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Background="#FAFAFA" Width="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource CompactToWidth}}" MinHeight="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource CompactToMinHeight}}">
                                                                <Border.ToolTip>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                                        <TextBlock Text="{Binding Mod.Description}"/>
                                                                        <TextBlock Text="{Binding TagsString}" Foreground="#666"/>
                                                                    </StackPanel>
                                                                </Border.ToolTip>
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <!-- Compact layout: image left, text right -->
                                                                    <Image x:Name="CompactImage" Source="{Binding Mod.Image, Converter={StaticResource ImagePlaceholder}, ConverterParameter=96}" Width="48" Height="48" Margin="0,0,8,0" Grid.Row="0" Grid.Column="0"
                                                                           Visibility="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                                                                    <StackPanel x:Name="CompactText" Grid.Column="1" Visibility="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding Mod.Description}" Foreground="#666" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding TagsString}" Foreground="#666" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                    <!-- Large layout: image on top, text below -->
                                                                    <Image x:Name="LargeImage" Source="{Binding Mod.Image, Converter={StaticResource ImagePlaceholder}, ConverterParameter=256}" Width="224" Height="224" Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="0,8,0,8"
                                                                           Visibility="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolInverseToVis}}"/>
                                                                    <StackPanel x:Name="LargeText" Grid.Row="1" Grid.ColumnSpan="2" Visibility="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolInverseToVis}}" Width="224" Height="56">
                                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,0,2" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding Mod.Description}" Foreground="#666" TextWrapping="NoWrap" Margin="0,0,0,2" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding TagsString}" Foreground="#666" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                    <!-- No triggers: visibility controlled via converters above -->
                                                                </Grid>
                                                                <Border.ContextMenu>
                                                                    <ContextMenu PreviewKeyDown="OnCardContextMenuKeyDown">
                                                                        <MenuItem Header="Add to Profile (A)" Click="OnAddToProfileClick"/>
                                                                        <MenuItem Header="Open Folder (O)" Click="OnOpenModFolderClick"/>
                                                                        <Separator/>
                                                                        <MenuItem Header="Rename (R)" Click="OnRenameModClick"/>
                                                                        <MenuItem Header="Edit Description (E)" Click="OnEditDescriptionClick"/>
                                                                        <MenuItem Header="Edit Image (I)" Click="OnEditImageClick"/>
                                                                        <MenuItem Header="Edit Tags (T)" Click="OnEditTagsPageClick"/>
                                                                        <Separator/>
                                                                        <MenuItem Header="Remove (D)" Click="OnRemoveModClick"/>
                                                                    </ContextMenu>
                                                                </Border.ContextMenu>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
