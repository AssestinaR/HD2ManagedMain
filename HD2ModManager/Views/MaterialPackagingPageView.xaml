<UserControl x:Class="HD2ModManager.Views.MaterialPackagingPageView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="920" HorizontalAlignment="Left">
            <TextBlock Text="{Binding OperationTitle, Mode=OneWay}" Style="{StaticResource AppPageTitle}"/>
            <TextBlock Text="{Binding SourceName, Mode=OneWay}" Foreground="{StaticResource TextPrimary}" Margin="0,6,0,4"/>
            <TextBlock Text="{Binding Explanation, Mode=OneWay}" Style="{StaticResource AppSupportingText}" Margin="0,0,0,18"/>

            <Border Style="{StaticResource AppCard}" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="材质包候选" Style="{StaticResource AppCardTitle}"/>
                    <ListBox ItemsSource="{Binding Candidates, Mode=OneWay}" SelectedItem="{Binding SelectedCandidate}" Margin="0,10,0,0" MaxHeight="300">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RequiresCandidate}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8" MinHeight="54">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <TextBlock Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0">
                                            <Run Text="匹配 "/><Run Text="{Binding MatchingMaterialCount, Mode=OneWay}"/>
                                            <Run Text="　缺材质 "/><Run Text="{Binding MissingMaterialCount, Mode=OneWay}"/>
                                            <Run Text="　缺贴图 "/><Run Text="{Binding MissingTextureCount, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding BlockerSummary, Mode=OneWay}" Foreground="{StaticResource StatusWarning}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText, Mode=OneWay}" Foreground="{Binding StatusBrush, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="此操作不需要选择材质包。" Margin="0,10,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource AppSupportingText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding RequiresCandidate}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AppCard}" Padding="16">
                <StackPanel>
                    <TextBlock Text="输出" Style="{StaticResource AppCardTitle}"/>
                    <Grid Margin="0,10,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource AppTextBox}" Text="{Binding OutputDirectory, Mode=OneWay}" IsReadOnly="True"/>
                        <Button Style="{StaticResource AppSecondaryButton}" Grid.Column="1" Content="浏览…" Command="{Binding BrowseCommand}" Margin="8,0,0,0"/>
                    </Grid>
                    <CheckBox Style="{StaticResource AppCheckBox}" Content="生成后自动导入 Mod 库" IsChecked="{Binding ImportToLibrary}" Margin="0,2,0,12"/>
                    <Button Style="{StaticResource AppPrimaryButton}" Content="生成材质候选" Command="{Binding GenerateCommand}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding State, Mode=OneWay}" Style="{StaticResource AppSupportingText}" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
