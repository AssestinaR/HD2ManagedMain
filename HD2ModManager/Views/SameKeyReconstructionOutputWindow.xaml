<Window x:Class="HD2ModManager.Views.SameKeyReconstructionOutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="生成当前版本正式验证候选" Width="610" Height="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F5F6F8">
    <StackPanel Margin="20">
        <TextBlock Text="重建摘要" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="#444" Margin="0,10,0,8"/>
        <Border Background="#FFF8E1" BorderBrush="#E0C66A" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
            <TextBlock Text="将生成独立的 current-target 正式验证候选；不会修改源 Mod、不会自动加入当前 Profile，也不会自动部署。输出会附带游戏内验收清单，请手动验证模型、骨骼与材质。" TextWrapping="Wrap" Foreground="#684E00"/>
        </Border>
        <RadioButton x:Name="FolderOption" Content="输出到指定文件夹" IsChecked="True" Margin="0,4,0,8"/>
        <Grid Margin="22,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="OutputPathText" IsReadOnly="True" VerticalContentAlignment="Center" Padding="7"/>
            <Button Grid.Column="1" Content="浏览..." Width="82" Margin="8,0,0,0" Click="Browse_Click"/>
        </Grid>
        <RadioButton x:Name="ImportOption" Content="写出并自动导入 Mod 库" Margin="0,0,0,2"/>
        <TextBlock Text="自动导入仅将新测试副本加入库，不会替换源 Mod 或改变 Profile。" TextWrapping="Wrap" Foreground="#666" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" Width="88" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="生成候选" Width="100" IsDefault="True" Click="Confirm_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
