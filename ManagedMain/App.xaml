<Application x:Class="ManagedMain.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Theme dictionaries -->
                <ResourceDictionary Source="/ManagedMain;component/Themes/Colors.xaml"/>
                <ResourceDictionary Source="/ManagedMain;component/Themes/Dimens.xaml"/>
                <ResourceDictionary Source="/ManagedMain;component/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Default window style uses light background -->
            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Icon" Value="/ManagedMain;component/helldivers2.ico"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
