<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Spacing (double) -->
  <sys:Double x:Key="SpaceS">8</sys:Double>
  <sys:Double x:Key="SpaceM">12</sys:Double>
  <sys:Double x:Key="SpaceL">16</sys:Double>
  <sys:Double x:Key="SpaceXL">20</sys:Double>
  <sys:Double x:Key="SpaceXXL">24</sys:Double>

  <!-- Corner radius -->
  <CornerRadius x:Key="RadiusS">8</CornerRadius>
  <CornerRadius x:Key="RadiusM">12</CornerRadius>
  <CornerRadius x:Key="RadiusL">16</CornerRadius>
  <CornerRadius x:Key="RadiusXL">20</CornerRadius>
  <CornerRadius x:Key="RadiusXXL">24</CornerRadius>

  <!-- Button standardized widths and height -->
  <sys:Double x:Key="BtnWidthS">84</sys:Double>
  <sys:Double x:Key="BtnWidthM">112</sys:Double>
  <sys:Double x:Key="BtnWidthL">148</sys:Double>
  <sys:Double x:Key="BtnHeight">32</sys:Double>

  <!-- Compact input heights -->
  <sys:Double x:Key="InputHeightS">24</sys:Double>
</ResourceDictionary>
