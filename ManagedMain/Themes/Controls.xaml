<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:ManagedMain.Converters">
  <!-- Card border with small radius -->
  <Style x:Key="CardBorder" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource CardBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="3"/>
    <Setter Property="Padding" Value="3"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <conv:CornerRadiusClampConverter x:Key="CornerClamp"/>
  <conv:ContentToTextConverter x:Key="ContentToText"/>
  <conv:LeadingTokenConverter x:Key="LeadingToken"/>
  <conv:LabelTextConverter x:Key="LabelText"/>
  <conv:ButtonLabelVisibilityConverter x:Key="BtnLabelVis"/>

  <!-- Section title -->
  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>

  <!-- Base pill button using light-blue accents -->
  <Style x:Key="PillButtonBase" TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="Padding" Value="3.5,2"/>
    <Setter Property="Background" Value="{StaticResource ButtonAccentWeakBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ButtonAccentMutedBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <!-- Default tooltip shows only string text extracted from Content -->
    <Setter Property="ToolTip">
      <Setter.Value>
        <ToolTip Content="{Binding RelativeSource={RelativeSource Self}, Path=PlacementTarget.Content, Converter={StaticResource ContentToText}}"/>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <Border.CornerRadius>
              <MultiBinding Converter="{StaticResource CornerClamp}" ConverterParameter="3">
                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualWidth"/>
                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualHeight"/>
              </MultiBinding>
            </Border.CornerRadius>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource ButtonAccentMutedBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- IconTextButton: forces size, centered icon+text string (uses emoji or icon char at start) -->
  <Style x:Key="IconTextButton" TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
    <Setter Property="Height" Value="{StaticResource BtnHeight}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Padding" Value="4,1.5"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <Border.CornerRadius>
              <MultiBinding Converter="{StaticResource CornerClamp}" ConverterParameter="3">
                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualWidth"/>
                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualHeight"/>
              </MultiBinding>
            </Border.CornerRadius>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, Converter={StaticResource LeadingToken}}"/>
              <TextBlock Margin="4,0,0,0">
                <TextBlock.Text>
                  <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Content" Converter="{StaticResource LabelText}"/>
                </TextBlock.Text>
                <TextBlock.Visibility>
                  <MultiBinding Converter="{StaticResource BtnLabelVis}">
                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualWidth"/>
                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Tag"/>
                  </MultiBinding>
                </TextBlock.Visibility>
              </TextBlock>
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Convenience aliases -->
  <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource IconTextButton}"/>
  <Style x:Key="PillButton.S" TargetType="Button" BasedOn="{StaticResource IconTextButton}">
    <Setter Property="Tag" Value="S"/>
  </Style>
  <Style x:Key="PillButton.M" TargetType="Button" BasedOn="{StaticResource IconTextButton}">
    <Setter Property="Tag" Value="M"/>
  </Style>
  <Style x:Key="PillButton.L" TargetType="Button" BasedOn="{StaticResource IconTextButton}">
    <Setter Property="Tag" Value="L"/>
  </Style>

  <!-- TreeView minimal -->
  <Style TargetType="TreeViewItem">
    <Setter Property="Margin" Value="0,2,0,2"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
  </Style>

  <!-- Big radio template -->
  <Style x:Key="BigRadio" TargetType="RadioButton">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <StackPanel Orientation="Horizontal" Margin="0,6">
            <Grid Width="20" Height="20" Margin="0,0,10,0">
              <Ellipse Stroke="{StaticResource ButtonAccentMutedBrush}" StrokeThickness="2" Fill="Transparent"/>
              <Ellipse Width="10" Height="10" Fill="{StaticResource ButtonAccentBrush}" Visibility="Collapsed" x:Name="Dot"/>
            </Grid>
            <ContentPresenter VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Dot" Property="UIElement.Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Shared breathing hint resources -->
  <Storyboard x:Key="BreathingStoryboard" RepeatBehavior="Forever" AutoReverse="True">
    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.8" To="1" Duration="0:0:1.2"/>
    <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                    From="#FF66A3FF" To="#FF2D7DFF" Duration="0:0:1.2"/>
    <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                    From="#22A9D2FF" To="#33A9D2FF" Duration="0:0:1.2"/>
  </Storyboard>
  <Style x:Key="BreathingHintBorder" TargetType="Border">
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="10"/>
    <Setter Property="Margin" Value="0,6,0,6"/>
    <Setter Property="Background" Value="#22A9D2FF"/>
    <Setter Property="BorderBrush" Value="#FF66A3FF"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Style.Triggers>
      <EventTrigger RoutedEvent="Loaded">
        <BeginStoryboard Storyboard="{StaticResource BreathingStoryboard}"/>
      </EventTrigger>
    </Style.Triggers>
  </Style>

  <!-- Toggle pill styles matching button look -->
  <Style x:Key="PillToggleBase" TargetType="ToggleButton">
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="Padding" Value="3.5,2"/>
    <Setter Property="Background" Value="{StaticResource ButtonAccentWeakBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ButtonAccentMutedBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <Border.CornerRadius>
              <MultiBinding Converter="{StaticResource CornerClamp}" ConverterParameter="3">
                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualWidth"/>
                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualHeight"/>
              </MultiBinding>
            </Border.CornerRadius>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource ButtonAccentMutedBrush}"/>
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Background" Value="{StaticResource ButtonAccentMutedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ButtonAccentBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="PillToggle.S" TargetType="ToggleButton" BasedOn="{StaticResource PillToggleBase}">
    <Setter Property="Height" Value="{StaticResource BtnHeight}"/>
    <Setter Property="MinWidth" Value="{StaticResource BtnWidthS}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Padding" Value="4,1.5"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

</ResourceDictionary>
