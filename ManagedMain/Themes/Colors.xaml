<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme palette (soft lilac) -->
    <!-- Base colors -->
    <Color x:Key="BgColor">#FFF6F0FA</Color>
    <Color x:Key="CardColor">#FFEFE6F5</Color>
    <Color x:Key="CardBorderColor">#FFDCD0EA</Color>
    <Color x:Key="TextPrimaryColor">#FF2E2A32</Color>
    <Color x:Key="TextSecondaryColor">#992E2A32</Color>
    <Color x:Key="DividerColor">#332E2A32</Color>

    <!-- Accents (purple, used by log card / tri-state) -->
    <Color x:Key="AccentColor">#FF9C8ED0</Color>
    <Color x:Key="AccentWeakColor">#1A9C8ED0</Color>
    <Color x:Key="AccentMutedColor">#FFB9AEDC</Color>
    <Color x:Key="WarnColor">#FFE2A570</Color>

    <!-- Warm tones for specific cards -->
    <Color x:Key="WarmCardColor">#FFF7F1E3</Color>
    <Color x:Key="WarmCardBorderColor">#FFE7D9BF</Color>

    <!-- Light blue accents for toolbar PillButton -->
    <Color x:Key="ButtonAccentColor">#FF7FB3FF</Color>
    <Color x:Key="ButtonAccentMutedColor">#FFA9C7FF</Color>
    <Color x:Key="ButtonAccentWeakColor">#1A7FB3FF</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentWeakBrush" Color="{StaticResource AccentWeakColor}"/>
    <SolidColorBrush x:Key="AccentMutedBrush" Color="{StaticResource AccentMutedColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>

    <!-- Warm card brushes -->
    <SolidColorBrush x:Key="WarmCardBrush" Color="{StaticResource WarmCardColor}"/>
    <SolidColorBrush x:Key="WarmCardBorderBrush" Color="{StaticResource WarmCardBorderColor}"/>

    <!-- Button light blue brushes -->
    <SolidColorBrush x:Key="ButtonAccentBrush" Color="{StaticResource ButtonAccentColor}"/>
    <SolidColorBrush x:Key="ButtonAccentMutedBrush" Color="{StaticResource ButtonAccentMutedColor}"/>
    <SolidColorBrush x:Key="ButtonAccentWeakBrush" Color="{StaticResource ButtonAccentWeakColor}"/>

    <!-- Darker window frame border -->
    <Color x:Key="WindowFrameColor">#66000000</Color>
    <SolidColorBrush x:Key="WindowFrameBrush" Color="{StaticResource WindowFrameColor}"/>

    <!-- Neutral selection for tabs (avoid purple) -->
    <Color x:Key="TabSelectedColor">#FFF2F4F7</Color>
    <SolidColorBrush x:Key="TabSelectedBrush" Color="{StaticResource TabSelectedColor}"/>
    <!-- Neutral border for selected tab -->
    <Color x:Key="TabSelectedBorderColor">#FFDDE3EA</Color>
    <SolidColorBrush x:Key="TabSelectedBorderBrush" Color="{StaticResource TabSelectedBorderColor}"/>
</ResourceDictionary>
