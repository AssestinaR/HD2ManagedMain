<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <ApplicationIcon>helldivers2.ico</ApplicationIcon>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Remove="Shadow\**" />
    <None Remove="Shadow\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.40.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- XAML pages -->
    <Page Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="App.xaml.cs">
      <DependentUpon>App.xaml</DependentUpon>
    </Compile>
    <Compile Include="Converters\BoolNegationConverter.cs" />
    <Compile Include="Converters\BoolOrMultiConverter.cs" />
    <Compile Include="Converters\ContentToTextConverter.cs" />
    <Compile Include="Converters\LastItemConverter.cs" />

    <Compile Include="Converters\ModFileGroupEnabledConverter.cs" />

    <Compile Include="Converters\ProfileEntryStatusBrushConverter.cs" />
    <Compile Include="Converters\ProfileImageConverter.cs" />
    <Compile Include="Services\GameLauncher.cs" />
    <Compile Include="Services\LogLevel.cs" />
    <Compile Include="Services\SteamLocator.cs" />
    <Compile Include="Services\TreeTransformPort.cs" />
    <Compile Include="UI\Drag\TreeDragManager.cs" />
    <Compile Include="UI\Drag\TreeInsertAdorner.cs" />
    <Compile Include="Views\BreathingEffect.cs" />
    <Compile Include="Views\LogDrawerHost.cs" />
    <Compile Include="Views\StatusDrawerHost.cs" />
    <Compile Include="Views\WaveEffect.cs" />

    <Page Include="MainWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="MainWindow.xaml.cs">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </Compile>

    <Page Include="Views\ManagedMainView.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="Views\ManagedMainView.xaml.cs">
      <DependentUpon>ManagedMainView.xaml</DependentUpon>
    </Compile>

    <Page Include="Views\ProfileModsView.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="Views\ProfileModsView.xaml.cs">
      <DependentUpon>ProfileModsView.xaml</DependentUpon>
    </Compile>

    <Page Include="Views\RenameDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="Views\RenameDialog.xaml.cs">
      <DependentUpon>RenameDialog.xaml</DependentUpon>
    </Compile>

    <Page Include="Views\RemarkDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="Views\RemarkDialog.xaml.cs">
      <DependentUpon>RemarkDialog.xaml</DependentUpon>
    </Compile>

    <Page Include="Views\InputDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="Views\InputDialog.xaml.cs">
      <DependentUpon>InputDialog.xaml</DependentUpon>
    </Compile>

    <!-- Themes -->
    <Page Include="Themes\Colors.xaml" />
    <Page Include="Themes\Dimens.xaml" />
    <Page Include="Themes\Controls.xaml" />

    <!-- Detail templates dictionary -->
    <Page Include="Views\ModDetailTemplates.xaml" />

    <!-- C# code files -->
    <Compile Include="Models\OptionModels.cs" />
    <Compile Include="Models\ModListModels.cs" />
    <Compile Include="Models\ProfileStats.cs" />

    <Compile Include="Services\LogService.cs" />
    <Compile Include="Services\OptionStore.cs" />
    <Compile Include="Services\ModListStatsService.cs" />
    <Compile Include="Services\ModListStore.cs" />
    <Compile Include="Services\FileGroupScanner.cs" />
    <Compile Include="Services\ImportService.cs" />
    <Compile Include="Services\ExportService.cs" />
    <Compile Include="Services\ActivationService.cs" />

    <Compile Include="ViewModels\ManagedMainViewModel.cs" />
    <Compile Include="ViewModels\ProfileModsViewModel.cs" />
    <Compile Include="ViewModels\ProfileTabViewModel.cs" />
    <Compile Include="ViewModels\ShellViewModel.cs" />
    <Compile Include="ViewModels\MainViewModel.cs" />

    <Compile Include="Converters\ModImageConverter.cs" />
    <Compile Include="Converters\CornerRadiusClampConverter.cs" />
    <Compile Include="Converters\EnabledStateTextConverter.cs" />
    <Compile Include="Converters\EnabledStateBrushConverter.cs" />

    <!-- Behaviors -->
    <Compile Include="UI\Behaviors\HoverPopupBehavior.cs" />

    <!-- Designer stub for RESX (manual, no implicit codegen needed) -->
    <Compile Include="Resources\Strings.Designer.cs">
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="helldivers2.png" />
    <Resource Include="helldivers2.ico" />
  </ItemGroup>

  <!-- Remove incorrect None Update for RemarkDialog.xaml -->
  <ItemGroup>
    <None Remove="Views\RemarkDialog.xaml" />
  </ItemGroup>

  <!-- Remove old XAML localization dictionaries from build -->
  <ItemGroup>
    <Page Remove="Resources\StringResources.en-US.xaml" />
    <Page Remove="Resources\StringResources.zh-CN.xaml" />
  </ItemGroup>

</Project>
