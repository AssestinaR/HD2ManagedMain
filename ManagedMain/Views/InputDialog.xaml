<Window x:Class="ManagedMain.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resx="clr-namespace:ManagedMain.Resources"
        Title="Input" Height="160" Width="420" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="MsgText" Text="{x:Static resx:Strings.SR_Prompt_EnterUrl}" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <TextBox x:Name="InputBox" Grid.Row="1" MinWidth="360"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static resx:Strings.SR_Dlg_Ok}" Width="76" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="{x:Static resx:Strings.SR_Dlg_Cancel}" Width="76" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
