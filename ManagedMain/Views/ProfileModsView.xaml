<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ManagedMain.Views.ProfileModsView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Models="clr-namespace:ManagedMain.Models"
             xmlns:Conv="clr-namespace:ManagedMain.Converters"
             xmlns:ld="clr-namespace:ManagedMain.Views"
             xmlns:resx="clr-namespace:ManagedMain.Resources"
             mc:Ignorable="d"
             Background="White"
             ld:LogDrawerHost.ItemsSource="{Binding Log.Lines}"
             ld:LogDrawerHost.ToggleButton="{Binding ElementName=BtnLogToggle}"
             ld:LogDrawerHost.AutoCloseSeconds="5"  
             ld:LogDrawerHost.AutoOpenEnabled="False"
             ld:StatusDrawerHost.ModsSource="{Binding Mods}"
             ld:StatusDrawerHost.ProfileRoot="{Binding Profile.RootPath}"
             ld:StatusDrawerHost.GameFolder="{Binding GameFolder}"
             ld:StatusDrawerHost.ToggleButton="{Binding ElementName=BtnStatusToggle}"
             ld:StatusDrawerHost.HeightRatio="1.0"
             ld:StatusDrawerHost.MinHeight="0"
             AllowDrop="True"
             DragOver="Root_DragOver" DragLeave="Root_DragLeave" Drop="Root_Drop">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Use component URI to load dictionary from same assembly -->
                <ResourceDictionary Source="/ManagedMain;component/Views/ModDetailTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Conv:ModImageConverter x:Key="ModImageConv"/>
            <Conv:EnabledStateTextConverter x:Key="EnabledStateTextConverter"/>
            <Conv:ModFileGroupEnabledBrushConverter x:Key="GroupEnabledBrushConverter"/>
            <Conv:EnabledStateBrushConverter x:Key="EnabledBrushConv"/>
            <Conv:BoolNegationConverter x:Key="BoolNeg"/>
            <Conv:LastItemConverter x:Key="LastItemConv"/>

            <!-- TreeView styles needed by left pane -->
            <Style x:Key="ExpandArrowPathStyle" TargetType="Path">
                <Setter Property="Width" Value="12"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="Fill" Value="#666"/>
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="Data" Value="M0,0 L6,5 0,10 Z"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsExpanded}" Value="True">
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <RotateTransform Angle="90"/>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=HasItems}" Value="False">
                        <!-- use Hidden to reserve arrow space for leaf items -->
                        <Setter Property="Visibility" Value="Hidden"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="PrettyTreeItemStyle" TargetType="TreeViewItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TreeViewItem">
                            <StackPanel>
                                <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="6" Margin="3,2,3,2" MinHeight="34">
                                    <DockPanel LastChildFill="True">
                                    <Path x:Name="Exp" Style="{StaticResource ExpandArrowPathStyle}" VerticalAlignment="Center"/>
                                        <ContentPresenter x:Name="PART_Header" ContentSource="Header"/>
                                    </DockPanel>
                                </Border>
                                <ItemsPresenter x:Name="ItemsHost" Margin="32,0,0,0"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="False">
                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FFCFEAFF"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FF5AA9FF"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FFE6F3FF"/>
                                </Trigger>
                                <Trigger Property="HasItems" Value="False">
                                    <!-- use Hidden to keep alignment with arrow space -->
                                    <Setter TargetName="Exp" Property="Visibility" Value="Hidden"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Local override to match ManagedMainView Launch button width -->
            <Style x:Key="PillButton.L" TargetType="Button" BasedOn="{StaticResource IconTextButton}">
                <Setter Property="Width" Value="150"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel>
        <!-- Toolbar use default appearance and default button style -->
        <ToolBar DockPanel.Dock="Top" IsEnabled="{Binding IsBusy, Converter={StaticResource BoolNeg}}">
            <Button x:Name="BtnImportFolder" Style="{StaticResource PillButton.L}" Command="{Binding ImportFolderCommand}" ld:WaveEffect.IsSurging="{Binding IsImportFolderRunning}">
                <TextBlock><Run Text="📁 "/><Run Text="{x:Static resx:Strings.SR_Btn_ImportFolder}"/></TextBlock>
            </Button>
            <Button x:Name="BtnImportArchive" Style="{StaticResource PillButton.L}" Command="{Binding ImportArchiveCommand}" ld:WaveEffect.IsSurging="{Binding IsImportArchiveRunning}">
                <TextBlock><Run Text="🗜️ "/><Run Text="{x:Static resx:Strings.SR_Btn_ImportArchive}"/></TextBlock>
            </Button>
            <Button Style="{StaticResource PillButton.S}" Command="{Binding DeleteSelectedCommand}">
                <TextBlock><Run Text="🗑️ "/><Run Text="{x:Static resx:Strings.SR_Btn_Delete}"/></TextBlock>
            </Button>
            <Button Style="{StaticResource PillButton.S}" Command="{Binding ExportSelectedCommand}">
                <TextBlock><Run Text="📤 "/><Run Text="{x:Static resx:Strings.SR_Btn_Export}"/></TextBlock>
            </Button>
            <Button Style="{StaticResource PillButton.S}" Command="{Binding EnableSelectedCommand}">
                <TextBlock><Run Text="✅ "/><Run Text="{x:Static resx:Strings.SR_Btn_Enable}"/></TextBlock>
            </Button>
            <Button Style="{StaticResource PillButton.S}" Command="{Binding DisableSelectedCommand}">
                <TextBlock><Run Text="🚫 "/><Run Text="{x:Static resx:Strings.SR_Btn_Disable}"/></TextBlock>
            </Button>
            <Button Style="{StaticResource PillButton.M}" Command="{Binding NewEmptyModCommand}">
                <TextBlock><Run Text="➕ "/><Run Text="{x:Static resx:Strings.SR_Btn_NewMod}"/></TextBlock>
            </Button>
            <Separator/>
            <Button x:Name="BtnStatusToggle" Style="{StaticResource PillButton.M}">
                <TextBlock><Run Text="🧭 "/><Run Text="{x:Static resx:Strings.SR_Btn_Status}"/></TextBlock>
            </Button>
            <Separator/>
            <Button x:Name="BtnLaunchGame" HorizontalAlignment="Right" HorizontalContentAlignment="Center" Style="{StaticResource PillButton.L}"
                    Click="BtnLaunchGame_Click">
                <TextBlock>
                    <Run Text="🎮 "/><Run Text="{x:Static resx:Strings.SR_Btn_LaunchGame}"/>
                </TextBlock>
            </Button>
        </ToolBar>
        <!-- Bottom status bar (raised height to fit PillButton.S) -->
        <Border DockPanel.Dock="Bottom" Height="36" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="1,1,1,0">
            <DockPanel LastChildFill="True" Margin="6,0,6,0">
                <Button x:Name="BtnLogToggle" Style="{StaticResource PillButton.S}" Margin="0,4,8,4">
                    <TextBlock><Run Text="📜 "/><Run Text="{x:Static resx:Strings.SR_Title_Log}"/></TextBlock>
                </Button>
                <TextBlock VerticalAlignment="Center" FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Log.Latest, FallbackValue=''}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#666"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Log.LatestLevel}" Value="Warn">
                                    <Setter Property="Foreground" Value="#CC8B00"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Log.LatestLevel}" Value="Error">
                                    <Setter Property="Foreground" Value="#CC0000"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Log.LatestLevel}" Value="Debug">
                                    <Setter Property="Foreground" Value="#888"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>
        <Grid Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.618*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- Left: warm card -->
            <Border Style="{StaticResource CardBorder}" Margin="5,5,5,5"
                    Background="{StaticResource WarmCardBrush}" BorderBrush="{StaticResource WarmCardBorderBrush}">
                <DockPanel>
                    <TextBlock Text="{x:Static resx:Strings.SR_Title_ModList}" DockPanel.Dock="Top" Margin="0,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=ModsTree, Path=HasItems}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Separator Background="{StaticResource DividerBrush}" Height="1" Visibility="Collapsed">
                        <Separator.Style>
                            <Style TargetType="Separator">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=ModsTree, Path=HasItems}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Separator.Style>
                    </Separator>
                    <TreeView x:Name="ModsTree" Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                              ItemsSource="{Binding Mods}" SelectedItemChanged="ModsTree_SelectedItemChanged"
                              ItemContainerStyle="{StaticResource PrettyTreeItemStyle}"
                              PreviewMouseDown="ModsTree_PreviewMouseDown" MouseMove="ModsTree_MouseMove"
                              PreviewMouseWheel="ModsTree_PreviewMouseWheel"
                              AllowDrop="True" DragOver="ModsTree_DragOver" Drop="ModsTree_Drop"
                              TextElement.FontSize="16">
                        <TreeView.Resources>
                            <!-- Templates for tree headers -->
                            <HierarchicalDataTemplate DataType="{x:Type Models:MainModItem}" ItemsSource="{Binding Options}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Width="30" Height="30" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Image.Source>
                                            <MultiBinding Converter="{StaticResource ModImageConv}" FallbackValue="/ManagedMain;component/helldivers2.png">
                                                <Binding Path="IconPath"/>
                                                <Binding ElementName="Root" Path="DataContext"/>
                                                <Binding Path="."/>
                                            </MultiBinding>
                                        </Image.Source>
                                    </Image>
                                    <TextBlock x:Name="NameText" Text="{Binding Name}" VerticalAlignment="Center"
                                               Foreground="{Binding Enabled, Converter={StaticResource EnabledBrushConv}}"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type Models:OptionItem}" ItemsSource="{Binding SubOptions}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Width="30" Height="30" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Image.Source>
                                            <MultiBinding Converter="{StaticResource ModImageConv}" FallbackValue="/ManagedMain;component/helldivers2.png">
                                                <Binding Path="IconPath"/>
                                                <Binding ElementName="Root" Path="DataContext"/>
                                                <Binding Path="."/>
                                            </MultiBinding>
                                        </Image.Source>
                                    </Image>
                                    <TextBlock x:Name="NameText" Text="{Binding Name}" VerticalAlignment="Center"
                                               Foreground="{Binding Enabled, Converter={StaticResource EnabledBrushConv}}"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type Models:SubOptionItem}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Width="30" Height="30" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Image.Source>
                                            <MultiBinding Converter="{StaticResource ModImageConv}" FallbackValue="/ManagedMain;component/helldivers2.png">
                                                <Binding Path="IconPath"/>
                                                <Binding ElementName="Root" Path="DataContext"/>
                                                <Binding Path="."/>
                                            </MultiBinding>
                                        </Image.Source>
                                    </Image>
                                    <TextBlock x:Name="NameText" Text="{Binding Name}" VerticalAlignment="Center"
                                               Foreground="{Binding Enabled, Converter={StaticResource EnabledBrushConv}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Right top: warm card -->
            <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource CardBorder}" Margin="5,5,5,5"
                    Background="{StaticResource WarmCardBrush}" BorderBrush="{StaticResource WarmCardBorderBrush}">
                <DockPanel>
                    <TextBlock Text="{x:Static resx:Strings.SR_Title_Properties}" DockPanel.Dock="Top" Margin="0,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Separator Background="{StaticResource DividerBrush}" Height="1" Visibility="Collapsed">
                        <Separator.Style>
                            <Style TargetType="Separator">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Margin" Value="0,2,0,2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Separator.Style>
                    </Separator>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <ContentControl Content="{Binding SelectedItem}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Drag-and-drop overlay -->
            <Grid x:Name="DropOverlay" Grid.ColumnSpan="2" Background="#66000000" Visibility="Collapsed" IsHitTestVisible="False">
                <Border Background="#CCFFFFFF" CornerRadius="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static resx:Strings.SR_Tip_DropHereToImport}" FontSize="20" Foreground="#333"/>
                </Border>
            </Grid>

            <!-- Bottom drawer injected by LogDrawerHost -->
        </Grid>
    </DockPanel>
</UserControl>
