<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ManagedMain.Views.ManagedMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:ManagedMain.Models"
             xmlns:ld="clr-namespace:ManagedMain.Views"
             xmlns:conv="clr-namespace:ManagedMain.Converters"
             xmlns:resx="clr-namespace:ManagedMain.Resources"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             ld:LogDrawerHost.ItemsSource="{Binding Log.Lines}"
             ld:LogDrawerHost.ToggleButton="{Binding ElementName=BtnLogToggle}"
             ld:LogDrawerHost.AutoCloseSeconds="5">
    <UserControl.Resources>
        <conv:BoolNegationConverter x:Key="BoolNeg"/>
        <conv:ProfileEntryStatusBrushConverter x:Key="ProfileBrushConv"/>
        <!-- Optional local width overrides -->
        <Style x:Key="PillButton.M" TargetType="Button" BasedOn="{StaticResource IconTextButton}">
            <Setter Property="Width" Value="84"/>
        </Style>
        <Style x:Key="PillButton.L" TargetType="Button" BasedOn="{StaticResource IconTextButton}">
            <Setter Property="Width" Value="150"/>
        </Style>

        <!-- TreeView styles to match ProfileModsView -->
        <Style x:Key="ExpandArrowPathStyle" TargetType="Path">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Fill" Value="#666"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Data" Value="M0,0 L6,5 0,10 Z"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsExpanded}" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <RotateTransform Angle="90"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=HasItems}" Value="False">
                    <Setter Property="Visibility" Value="Hidden"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrettyTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="6" Margin="3,2,3,2" MinHeight="34">
                                <DockPanel LastChildFill="True">
                                    <Path x:Name="Exp" Style="{StaticResource ExpandArrowPathStyle}" VerticalAlignment="Center"/>
                                    <ContentPresenter x:Name="PART_Header" ContentSource="Header"/>
                                </DockPanel>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="32,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFCFEAFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF5AA9FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE6F3FF"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Exp" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Breathing animation for the hint panel -->
        <Storyboard x:Key="BreathingStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.8" To="1" Duration="0:0:1.2"/>
            <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                            From="#FF66A3FF" To="#FF2D7DFF" Duration="0:0:1.2"/>
            <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                            From="#22A9D2FF" To="#33A9D2FF" Duration="0:0:1.2"/>
        </Storyboard>
        <Style x:Key="BreathingHintBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="Background" Value="#22A9D2FF"/>
            <Setter Property="BorderBrush" Value="#FF66A3FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource BreathingStoryboard}"/>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Top toolbar -->
        <ToolBar DockPanel.Dock="Top" IsEnabled="{Binding IsBusy, Converter={StaticResource BoolNeg}}">
            <Button x:Name="BtnNewProfile" Style="{StaticResource PillButton.M}" Command="{Binding NewProfileCommand}">
                <TextBlock>
                    <Run Text="🆕 "/><Run Text="{x:Static resx:Strings.SR_Btn_New}"/>
                </TextBlock>
            </Button>
            <Button x:Name="BtnImportProfile" Style="{StaticResource PillButton.M}" Command="{Binding ImportProfileCommand}">
                <TextBlock>
                    <Run Text="📥 "/><Run Text="{x:Static resx:Strings.SR_Btn_Import}"/>
                </TextBlock>
            </Button>
            <Button Style="{StaticResource PillButton.M}" CommandParameter="{Binding SelectedProfile}" Command="{Binding CopyProfileCommand}" ld:WaveEffect.IsSurging="{Binding IsCopyRunning}">
                <TextBlock>
                    <Run Text="📄 "/><Run Text="{x:Static resx:Strings.SR_Btn_Copy}"/>
                </TextBlock>
            </Button>
            <Button Style="{StaticResource PillButton.M}" CommandParameter="{Binding SelectedProfile}" Command="{Binding DeleteProfileCommand}" ld:WaveEffect.IsSurging="{Binding IsDeleteRunning}">
                <TextBlock>
                    <Run Text="🗑 "/><Run Text="{x:Static resx:Strings.SR_Btn_Delete}"/>
                </TextBlock>
            </Button>
            <Separator/>
            <Button Style="{StaticResource PillButton.M}" CommandParameter="{Binding SelectedProfile}" Command="{Binding EnableProfileCommand}">
                <TextBlock>
                    <Run Text="✅ "/><Run Text="{x:Static resx:Strings.SR_Btn_Enable}"/>
                </TextBlock>
            </Button>
            <Button Style="{StaticResource PillButton.M}" CommandParameter="{Binding SelectedProfile}" Command="{Binding DisableProfileCommand}">
                <TextBlock>
                    <Run Text="🚫 "/><Run Text="{x:Static resx:Strings.SR_Btn_Disable}"/>
                </TextBlock>
            </Button>
            <Separator/>
            <Button Style="{StaticResource PillButton.L}" Command="{Binding SetGameFolderCommand}">
                <TextBlock>
                    <Run Text="📁 "/><Run Text="{x:Static resx:Strings.SR_Btn_SetGameFolder}"/>
                </TextBlock>
            </Button>
            <Separator/>
            <TextBlock VerticalAlignment="Center" Margin="6,0,4,0" FontSize="14" Text="{x:Static resx:Strings.SR_Label_GameFolder}"/>
            <TextBox Text="{Binding Options.GameFolder}" IsReadOnly="True"
                     VerticalAlignment="Center" MinWidth="195"
                     Height="{StaticResource InputHeightS}"
                     FontSize="13" Margin="1,3,1,0" Width="188"/>
            <Separator/>
            <Button x:Name="BtnLogToggle" Style="{StaticResource PillButton.S}">
                <TextBlock>
                    <Run Text="📜 "/><Run Text="{x:Static resx:Strings.SR_Title_Log}"/>
                </TextBlock>
            </Button>
            <Button x:Name="BtnLaunchGame_Main" HorizontalAlignment="Right" HorizontalContentAlignment="Center" Style="{StaticResource PillButton.L}" Command="{Binding LaunchGameCommand}">
                <TextBlock FontSize="14">
                    <Run Text="🎮 "/><Run Text="{x:Static resx:Strings.SR_Btn_LaunchGame}"/>
                </TextBlock>
            </Button>
        </ToolBar>

        <!-- Main grid: match ProfileModsView proportions and card layout -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.618*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- Left card -->
            <Border Style="{StaticResource CardBorder}" Margin="5"
                    Background="{StaticResource WarmCardBrush}" BorderBrush="{StaticResource WarmCardBorderBrush}">
                <DockPanel>
                    <TextBlock Text="{x:Static resx:Strings.SR_Title_Profiles}" DockPanel.Dock="Top" Margin="0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=ProfilesTree, Path=HasItems}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Separator Background="{StaticResource DividerBrush}" Height="1" Visibility="Collapsed">
                        <Separator.Style>
                            <Style TargetType="Separator">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=ProfilesTree, Path=HasItems}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Separator.Style>
                    </Separator>

                    <!-- Empty state hint: show when no profiles -->
                    <Border DockPanel.Dock="Top">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource BreathingHintBorder}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=ProfilesTree, Path=HasItems}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💡" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="{x:Static resx:Strings.SR_Tip_NoProfilesHint}"/>
                        </StackPanel>
                    </Border>

                    <TreeView x:Name="ProfilesTree" ItemsSource="{Binding Profiles}"
                              Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                              SelectedItemChanged="ProfilesTree_SelectedItemChanged"
                              ItemContainerStyle="{StaticResource PrettyTreeItemStyle}"
                              PreviewMouseDoubleClick="ProfilesTree_PreviewMouseDoubleClick"
                              PreviewMouseRightButtonDown="ProfilesTree_PreviewMouseRightButtonDown">
                        <TreeView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ProfileEntry}">
                                <StackPanel Orientation="Horizontal" Margin="2" VerticalAlignment="Center">
                                    <TextBlock Text="📄" Margin="0,0,6,0" FontSize="18"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center">
                                        <TextBlock.Foreground>
                                            <MultiBinding Converter="{StaticResource ProfileBrushConv}">
                                                <Binding Path="IsEnabled"/>
                                                <Binding Path="IsOpen"/>
                                            </MultiBinding>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Right card -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="5"
                    Background="{StaticResource WarmCardBrush}" BorderBrush="{StaticResource WarmCardBorderBrush}">
                <DockPanel>
                    <TextBlock Text="{x:Static resx:Strings.SR_Title_Properties}" DockPanel.Dock="Top" Margin="0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProfile}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Separator Background="{StaticResource DividerBrush}" Height="1" Visibility="Collapsed">
                        <Separator.Style>
                            <Style TargetType="Separator">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Margin" Value="0,2,0,2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProfile}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Separator.Style>
                    </Separator>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <StackPanel Margin="8,0,8,8">
                            <!-- Property toolbar for selected profile -->
                            <ToolBar>
                                <Button Style="{StaticResource PillButton.S}" Width="90" MinWidth="90" Command="{Binding RenameProfileCommand}" CommandParameter="{Binding SelectedProfile}">
                                    <TextBlock><Run Text="✏️ "/><Run Text="{x:Static resx:Strings.SR_Btn_Rename}"/></TextBlock>
                                </Button>
                                <Button Style="{StaticResource PillButton.L}" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding SelectedProfile}">
                                    <TextBlock><Run Text="📂 "/><Run Text="{x:Static resx:Strings.SR_Btn_OpenPath}"/></TextBlock>
                                </Button>
                                <Button Style="{StaticResource PillButton.L}" Command="{Binding ChangeFolderCommand}" CommandParameter="{Binding SelectedProfile}">
                                    <TextBlock><Run Text="🔁 "/><Run Text="{x:Static resx:Strings.SR_Btn_ChangePath}"/></TextBlock>
                                </Button>
                            </ToolBar>

                            <!-- Drive mismatch breathing hint -->
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource BreathingHintBorder}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedProfileDifferentDrive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💡" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="{x:Static resx:Strings.SR_Log_DifferentDriveHint}"/>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,8,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Grid.Column="0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3" Padding="6" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static resx:Strings.SR_Label_Mods}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding StatModCount}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3" Padding="6" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static resx:Strings.SR_Label_PatchGroups}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding StatPatchGroupCount}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3" Padding="6">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static resx:Strings.SR_Label_EnabledPatchGroups}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding StatEnabledPatchGroupCount}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3" Padding="6" Margin="0,6,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static resx:Strings.SR_Label_Path}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding SelectedProfile.RootPath}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Text="{x:Static resx:Strings.SR_Tip_ProfileTreeUsage}" Foreground="Gray"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>