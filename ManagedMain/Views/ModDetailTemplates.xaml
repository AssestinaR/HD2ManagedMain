<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:Models="clr-namespace:ManagedMain.Models"
                    xmlns:Conv="clr-namespace:ManagedMain.Converters"
                    xmlns:resx="clr-namespace:ManagedMain.Resources"
                    xmlns:ld="clr-namespace:ManagedMain.Views">
    <!-- Local resources required by templates -->
    <Conv:ModImageConverter x:Key="ModImageConv"/>
    <Conv:EnabledStateTextConverter x:Key="EnabledStateTextConverter"/>
    <Conv:ModFileGroupEnabledBrushConverter x:Key="GroupEnabledBrushConverter"/>
    <Conv:BoolToChoiceTextConverter x:Key="BoolToChoiceText"/>

    <!-- Detail templates for right properties pane -->
    <DataTemplate DataType="{x:Type Models:MainModItem}">
        <StackPanel>
            <ToolBar ld:AdaptiveToolbarLayout.IsEnabled="True">
                <Button Style="{StaticResource PillButton.S}" Command="{Binding DataContext.RenameSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                    <TextBlock><Run Text="📝 "/><Run Text="{x:Static resx:Strings.SR_Btn_Name}"/></TextBlock>
                </Button>
                <Button Style="{StaticResource PillButton.S}" Command="{Binding DataContext.EditRemarkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                    <TextBlock><Run Text="📝 "/><Run Text="{x:Static resx:Strings.SR_Btn_Remark}"/></TextBlock>
                </Button>
                <Button Style="{StaticResource PillButton.S}" Command="{Binding DataContext.ChangeImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                    <TextBlock><Run Text="🖼 "/><Run Text="{x:Static resx:Strings.SR_Btn_Image}"/></TextBlock>
                </Button>
                <Button Style="{StaticResource PillButton.S}" Command="{Binding DataContext.EditUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                    <TextBlock><Run Text="🔗 "/><Run Text="{x:Static resx:Strings.SR_Btn_Link}"/></TextBlock>
                </Button>
                <Button Style="{StaticResource PillButton.S}" Command="{Binding DataContext.OpenFolderSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                    <TextBlock><Run Text="📂 "/><Run Text="{x:Static resx:Strings.SR_Btn_Open}"/></TextBlock>
                </Button>
            </ToolBar>
            <!-- Stats -->
            <Grid Margin="0,8,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="3" Padding="6" Margin="0,0,6,0"
                        Cursor="Hand" ToolTip="{x:Static resx:Strings.SR_Tip_ToggleEnable}">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.ToggleEnableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </Border.InputBindings>
                    <StackPanel>
                        <TextBlock Text="{x:Static resx:Strings.SR_Label_EnableState}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Enabled, Converter={StaticResource EnabledStateTextConverter}}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3" Padding="6" Margin="0,0,6,0"
                        Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.ToggleOptionsSelectModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </Border.InputBindings>
                    <StackPanel>
                        <TextBlock>
                            <Run Text="{x:Static resx:Strings.SR_Label_OptionCount}"/>
                        </TextBlock>
                        <TextBlock>
                            <Run Text="{Binding Options.Count, Mode=OneWay}"/>
                            <Run Text=" "/>
                            <Run Text="{Binding OptionsSingleSelect, Converter={StaticResource BoolToChoiceText}}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3" Padding="6">
                    <StackPanel>
                        <TextBlock Text="{x:Static resx:Strings.SR_Label_FileGroupCount}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TotalFileGroupCount}"/>
                    </StackPanel>
                    <Border.ToolTip>
                        <ToolTip Placement="Mouse" HasDropShadow="True" MaxWidth="420" MaxHeight="360" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <ItemsControl ItemsSource="{Binding AllFileGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="{Binding ., Converter={StaticResource GroupEnabledBrushConverter}, TargetNullValue={StaticResource TextPrimaryBrush}}">
                                            <Run Text="{Binding HexPrefix}"/><Run Text=".patch_"/><Run Text="{Binding PatchN}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ToolTip>
                    </Border.ToolTip>
                </Border>
            </Grid>

            <!-- Title/desc/url -->
            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="Gray" Margin="0,4,0,6"/>
            <TextBlock Margin="0,6,0,8">
                <Hyperlink Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           CommandParameter="{Binding Url}">
                    <Run Text="{Binding Url}"/>
                </Hyperlink>
            </TextBlock>

            <!-- Preview moved below URL -->
            <Border Margin="0,0,0,8" CornerRadius="6" Background="#11000000"
                    Tag="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext}"
                    ToolTipService.InitialShowDelay="450"
                    ToolTipService.ShowDuration="60000"
                    ToolTipService.BetweenShowDelay="200">
                <Grid>
                    <Image Width="360" Height="Auto" Stretch="UniformToFill">
                        <Image.Source>
                            <MultiBinding Converter="{StaticResource ModImageConv}">
                                <Binding Path="Image"/>
                                <Binding Path="IconPath"/>
                                <Binding RelativeSource="{RelativeSource AncestorType=Border}" Path="Tag"/>
                                <Binding Path="."/>
                            </MultiBinding>
                        </Image.Source>
                    </Image>
                    <Border Background="#66000000" VerticalAlignment="Top" Height="24">
                        <TextBlock Text="{x:Static resx:Strings.SR_Tip_HoverPreview}" Foreground="White" VerticalAlignment="Center" Margin="8,0,8,0"/>
                    </Border>
                </Grid>
                <Border.ToolTip>
                    <ToolTip Placement="Mouse" HasDropShadow="True">
                        <Border Background="#CC000000" Padding="6" CornerRadius="6">
                            <Image Stretch="None">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource ModImageConv}">
                                        <Binding Path="PlacementTarget.DataContext.Image" RelativeSource="{RelativeSource AncestorType=ToolTip}"/>
                                        <Binding Path="PlacementTarget.DataContext.IconPath" RelativeSource="{RelativeSource AncestorType=ToolTip}"/>
                                        <Binding Path="PlacementTarget.Tag" RelativeSource="{RelativeSource AncestorType=ToolTip}"/>
                                        <Binding Path="PlacementTarget.DataContext" RelativeSource="{RelativeSource AncestorType=ToolTip}"/>
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                        </Border>
                    </ToolTip>
                </Border.ToolTip>
            </Border>
        </StackPanel>
    </DataTemplate>

