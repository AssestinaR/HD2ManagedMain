<Window x:Class="LiberTeaManager.SingleInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改" Height="140" Width="599" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" Icon="/helldivers2.png">
    <Border Margin="10" Padding="8" Background="#FFFDFDFD" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="LblPrompt" Margin="0,0,0,6" FontWeight="Bold"/>
            <TextBox x:Name="InputBox" Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                     TextWrapping="Wrap" AcceptsReturn="False"
                     KeyDown="InputBox_KeyDown"/>
            <TextBlock Grid.Row="2" Text="回车保存，或直接关闭窗口自动保存" Foreground="Gray" FontSize="12" Margin="0,6,0,0"/>
        </Grid>
    </Border>
</Window>