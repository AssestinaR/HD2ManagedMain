<Window x:Class="LiberTeaManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LiberTeaManager"
        Title="LiberTeaManager" Height="800" Width="1200"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop" DragLeave="Window_DragLeave"
        Closing="Window_Closing" Icon="/helldivers2.png" Background="White">
    <Window.Resources>
        <!-- Converters (仅保留存在的) -->
        <local:ModListImageMultiConverter x:Key="ModListImageMultiConverter"/>
        <local:EnabledStateTextConverter x:Key="EnabledStateTextConverter"/>
        <local:EnabledStateBrushConverter x:Key="EnabledStateBrushConverter"/>
        <local:FileGroupTooltipConverter x:Key="FileGroupTooltipConverter"/>
        <local:BoolToBrushConverter x:Key="BoolToBrushConverter"/>

        <!-- 样式 -->
        <Style TargetType="ToolBar">
            <Setter Property="Background" Value="#FFEEF5FD"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="#FFEEF5FD"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FFE6F3FF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#FFDCEFFF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="Button" BasedOn="{StaticResource FlatButton}"/>

        <Style x:Key="MultiSelectTreeViewItemStyle" TargetType="TreeViewItem">
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TreeViewItem_PreviewMouseLeftButtonDown"/>
            <EventSetter Event="PreviewMouseMove" Handler="TreeViewItem_PreviewMouseMove"/>
            <EventSetter Event="Drop" Handler="TreeViewItem_Drop"/>
            <EventSetter Event="DragOver" Handler="TreeViewItem_DragOver"/>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="TreeViewItem_PreviewMouseRightButtonDown"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="TreeViewItem_PreviewMouseLeftButtonUp"/>
            <Setter Property="local:TreeViewExpandBehavior.EnableSmartExpand" Value="True"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <ContentPresenter x:Name="PART_Header" ContentSource="Header"/>
                            <ItemsPresenter x:Name="ItemsHost" Margin="28,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TreeViewItem" x:Key="DragHighlightItemStyle" BasedOn="{StaticResource MultiSelectTreeViewItemStyle}">
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
        </Style>
        <Style x:Key="SelectableItemBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#FFCCE8FF"/>
                    <Setter Property="BorderBrush" Value="#FF4096D6"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE6F3FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExpandArrowPathStyle" TargetType="Path">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Fill" Value="#666"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Data" Value="M0,0 L6,5 0,10 Z"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsExpanded}" Value="True">
                    <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=HasItems}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Tree 模板 -->
        <HierarchicalDataTemplate x:Key="MainModTemplate" ItemsSource="{Binding Options}">
            <Border Style="{StaticResource SelectableItemBorderStyle}" Margin="2,1,2,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource ExpandArrowPathStyle}"/>
                    <Image Grid.Column="1" Width="32" Height="32">
                        <Image.Source>
                            <MultiBinding Converter="{StaticResource ModListImageMultiConverter}">
                                <Binding Path="IconPath"/>
                                <Binding Path="RootModName"/>
                            </MultiBinding>
                        </Image.Source>
                    </Image>
                    <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" Foreground="{Binding Enabled, Converter={StaticResource EnabledStateBrushConverter}}"/>
                </Grid>
            </Border>
            <HierarchicalDataTemplate.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding SubOptions}">
                    <Border Style="{StaticResource SelectableItemBorderStyle}" Margin="2,1,2,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Style="{StaticResource ExpandArrowPathStyle}"/>
                            <Image Grid.Column="1" Width="24" Height="24">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource ModListImageMultiConverter}">
                                        <Binding Path="IconPath"/>
                                        <Binding Path="RootModName"/>
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                            <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" Foreground="{Binding Enabled, Converter={StaticResource EnabledStateBrushConverter}}"/>
                        </Grid>
                    </Border>
                </HierarchicalDataTemplate>
            </HierarchicalDataTemplate.ItemTemplate>
        </HierarchicalDataTemplate>

        <!-- 详情模板（含按钮事件） -->
        <DataTemplate DataType="{x:Type local:MainModItem}">
            <StackPanel>
                <ToolBar>
                    <Button Content="📝 名称" Tag="{Binding}" Click="BtnRename_Click"/>
                    <Button Content="📝 备注" Tag="{Binding}" Click="BtnEditDescription_Click"/>
                    <Button Content="📷 图片" Tag="{Binding}" Click="BtnChangeImage_Click"/>
                    <Button Content="🔗 网址" Tag="{Binding}" Click="BtnEditUrl_Click"/>
                    <Button Content="📂 打开" Tag="{Binding}" Click="BtnOpenInExplorer_Click"/>
                </ToolBar>
                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="Gray" Margin="0,4,0,6"/>
                <TextBlock Margin="0,0,0,4"><Run Text="状态: "/><Run Text="{Binding Enabled, Converter={StaticResource EnabledStateTextConverter}}"/></TextBlock>
                <TextBlock Text="{Binding Options.Count, StringFormat=选项数量: {0}}" Foreground="Gray"/>
                <TextBlock Text="{Binding FileGroups.Count, StringFormat=文件组数量: {0}}" Foreground="Gray"/>
                <TextBlock Margin="0,6,0,0">
                    <Run Text="网址: "/>
                    <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="Hyperlink_RequestNavigate">
                        <TextBlock Text="{Binding Url}" Foreground="#2563EB"/>
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:OptionItem}">
            <StackPanel>
                <ToolBar>
                    <Button Content="📝 名称" Tag="{Binding}" Click="BtnRename_Click"/>
                    <Button Content="📝 备注" Tag="{Binding}" Click="BtnEditDescription_Click"/>
                    <Button Content="📷 图片" Tag="{Binding}" Click="BtnChangeImage_Click"/>
                    <Button Content="🔗 网址" Tag="{Binding}" Click="BtnEditUrl_Click"/>
                    <Button Content="📂 打开" Tag="{Binding}" Click="BtnOpenInExplorer_Click"/>
                </ToolBar>
                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="Gray" Margin="0,4,0,6"/>
                <TextBlock Margin="0,0,0,4"><Run Text="状态: "/><Run Text="{Binding Enabled, Converter={StaticResource EnabledStateTextConverter}}"/></TextBlock>
                <TextBlock Text="{Binding SubOptions.Count, StringFormat=子选项: {0}}" Foreground="Gray"/>
                <TextBlock Text="{Binding FileGroups.Count, StringFormat=文件组数量: {0}}" Foreground="Gray"/>
                <TextBlock Margin="0,6,0,0">
                    <Run Text="网址: "/>
                    <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="Hyperlink_RequestNavigate">
                        <TextBlock Text="{Binding Url}" Foreground="#2563EB"/>
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:SubOptionItem}">
            <StackPanel>
                <ToolBar>
                    <Button Content="📝 名称" Tag="{Binding}" Click="BtnRename_Click"/>
                    <Button Content="📝 备注" Tag="{Binding}" Click="BtnEditDescription_Click"/>
                    <Button Content="📷 图片" Tag="{Binding}" Click="BtnChangeImage_Click"/>
                    <Button Content="🔗 网址" Tag="{Binding}" Click="BtnEditUrl_Click"/>
                    <Button Content="📂 打开" Tag="{Binding}" Click="BtnOpenInExplorer_Click"/>
                </ToolBar>
                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="Gray" Margin="0,4,0,6"/>
                <TextBlock Margin="0,0,0,4"><Run Text="状态: "/><Run Text="{Binding Enabled, Converter={StaticResource EnabledStateTextConverter}}"/></TextBlock>
                <TextBlock Text="{Binding FileGroups.Count, StringFormat=文件组数量: {0}}" Foreground="Gray"/>
                <TextBlock Margin="0,6,0,0">
                    <Run Text="网址: "/>
                    <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="Hyperlink_RequestNavigate">
                        <TextBlock Text="{Binding Url}" Foreground="#2563EB"/>
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <ToolBar DockPanel.Dock="Top" Margin="5" Background="#FFEBF5FD">
            <Button Content="📂 加载新Mod" Click="BtnLoadMod_Click"/>
            <Button Content="📂 加载已解压的mod" Click="BtnLoadExtractedMod_Click"/>
            <Button Content="✅ 启用" Click="BtnEnable_Click"/>
            <Button Content="❌ 禁用" Click="BtnDisable_Click"/>
            <Button Content="🗑️ 删除" Click="BtnDelete_Click"/>
            <Button Content="📤 导出" Click="BtnExportMod_Click"/>
            <Button Content="🔄 反选" Click="BtnInvertSelection_Click"/>
            <Button Content="⚙️ 设置" Click="BtnSettings_Click"/>
            <Separator/>
            <TextBlock VerticalAlignment="Center" Foreground="Gray" Margin="10,0,0,0" Text="{Binding AllEnabledFileGroupCount, StringFormat=目前已启用了{0}个文件组}" />
            <TextBlock Text="⚙️ 已启用的配置文件:" Margin="15,0,4,0" VerticalAlignment="Center"/>
            <ComboBox Width="150" ItemsSource="{Binding Profiles}" SelectedItem="{Binding CurrentProfile}" SelectionChanged="ProfileCombo_SelectionChanged"/>
            <Separator/>
            <Button Content="🆕 新建空mod" Click="BtnNewEmptyMod_Click"/>
            <Separator/>
            <Button Content="🔍 启用状态" Click="BtnShowEnabledStatus_Click"/>
        </ToolBar>

        <TextBox x:Name="LogTextBox" Margin="5" IsReadOnly="True" Height="80" DockPanel.Dock="Bottom" Background="#FFECECF9" BorderBrush="Transparent"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <TreeView Grid.Column="0" Name="ModTreeView" Margin="5,5,10,5"
                      ItemsSource="{Binding ModItems}" Background="#FFFDF5EB" FontSize="15" BorderBrush="Transparent"
                      ItemContainerStyle="{StaticResource DragHighlightItemStyle}" AllowDrop="True"
                      ItemTemplate="{StaticResource MainModTemplate}"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"/>

            <Border Margin="0,5,5,5" Padding="10" Background="#FFFDF5EB" BorderThickness="1" CornerRadius="4" Grid.Column="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ContentControl Content="{Binding DetailItem}"/>
                </ScrollViewer>
            </Border>

            <Border x:Name="GlobalDropOverlay" Visibility="Collapsed" Background="#40007ACC" Grid.ColumnSpan="2" CornerRadius="6" IsHitTestVisible="False">
                <TextBlock Text="{Binding DropHintText}" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
