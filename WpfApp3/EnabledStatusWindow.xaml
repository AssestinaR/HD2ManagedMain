<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="LiberTeaManager.EnabledStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enabled Status" Height="600" Width="900" Background="White" WindowStartupLocation="CenterOwner" Icon="/helldivers2.png">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top" Background="#FFEBF5FD" Padding="4">
            <TextBox x:Name="FilterBox" Width="180" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <CheckBox x:Name="OnlyIssuesCheck" Content="Only Issues" Margin="0,0,8,0" Checked="OnlyIssuesCheck_Changed" Unchecked="OnlyIssuesCheck_Changed"/>
            <Button Content="Refresh" Click="RefreshButton_Click"/>
            <TextBlock Text="Double click row to copy path" Foreground="Gray" Margin="20,0,0,0" VerticalAlignment="Center"/>
        </ToolBar>
        <DataGrid x:Name="StatusGrid" Margin="6" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ItemsSource="{Binding ViewItems}" MouseDoubleClick="StatusGrid_MouseDoubleClick">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="ToolTip" Value="{Binding Tooltip}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ExistsInGame}" Value="False"><Setter Property="Background" Value="#FFFFE5E5"/></DataTrigger>
                        <DataTrigger Binding="{Binding Mismatch}" Value="True"><Setter Property="Background" Value="#FFFFF6D5"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Owner" Binding="{Binding OwnerDisplay}" Width="200"/>
                <DataGridTextColumn Header="Hex" Binding="{Binding HexPrefix}" Width="130"/>
                <DataGridTextColumn Header="ModList" Binding="{Binding PatchN_ModList}" Width="70"/>
                <DataGridTextColumn Header="Game" Binding="{Binding PatchN_Game}" Width="70"/>
                <DataGridTextColumn Header="Exists" Binding="{Binding ExistsInGame}" Width="60"/>
                <DataGridTextColumn Header="All" Binding="{Binding FilesAllLinked}" Width="50"/>
                <DataGridTextColumn Header="Count" Binding="{Binding FileCount}" Width="60"/>
                <DataGridTextColumn Header="Link" Binding="{Binding LinkType}" Width="60"/>
                <DataGridTextColumn Header="GameFile" Binding="{Binding GameFileName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>